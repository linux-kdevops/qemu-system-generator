[VM]
QemuBinary=$knix/nix/qemu/bin/qemu-system-x86_64

[QEMU]
machine=q35
$firmware
accel=kvm
cpu=host
m=2G
smp=$cpus
nographic=
serial=mon:stdio
kernel=$knix/nix/$kernel/bzImage
nic=user,model=virtio-net-pci-non-transitional
netdev=dgram,id=lan,remote.type=inet,remote.host=239.255.0.1,remote.port=5557,local.type=inet,local.host=127.0.0.1,local.port=0
device=virtio-net-pci-non-transitional,netdev=lan,mac=52:54:00:00:00:$cid
device=vhost-vsock-pci-non-transitional,guest-cid=$cid

[virtiofsd]
shared-dir=/nix/store
tag=store
sandbox=namespace
uid-map=:0:%U:1:
gid-map=:0:%G:1:

[virtiofsd]
shared-dir=$knix/nix/$kernel-modules/lib/modules
tag=modules
sandbox=namespace
uid-map=:0:%U:1:
gid-map=:0:%G:1:

[virtiofsd]
shared-dir=%h
tag=home
sandbox=namespace
uid-map=:0:%U:1:
gid-map=:0:%G:1:
