# SPDX-License-Identifier: copyleft-next-0.3.1
[VM]
QEMUBinary=$WORKTREES_DIR/knix/result-qemu/bin/qemu-system-x86_64
SSHPrivateKey=$SSH_KEY

[QEMU]
machine=q35
nodefaults=
bios=qboot.rom
accel=kvm
cpu=host
m=2G
smp=4
nographic=
serial=mon:stdio
kernel=$WORKTREES_DIR/knix/result-kernel/boot/vmlinuz-7.3.0
netdev=user,id=net0,hostfwd=tcp:127.0.0.1:10049-:22
device=virtio-net-pci-non-transitional,netdev=net0,romfile=
netdev=dgram,id=lan,remote.type=inet,remote.host=239.255.0.1,remote.port=5557,local.type=inet,local.host=127.0.0.1,local.port=0
device=virtio-net-pci-non-transitional,netdev=lan,mac=52:54:00:00:00:49,romfile=
device=vhost-vsock-pci-non-transitional,guest-cid=49

[virtiofsd]
shared-dir=/nix/store
tag=store
cache=always
sandbox=namespace
uid-map=:0:%U:1:
gid-map=:0:%G:1:

[virtiofsd]
shared-dir=$WORKTREES_DIR/knix/result-kernel/lib/modules
tag=modules
sandbox=namespace
uid-map=:0:%U:1:
gid-map=:0:%G:1:

[virtiofsd]
shared-dir=%h
tag=home
sandbox=namespace
uid-map=:0:%U:1:
gid-map=:0:%G:1:
