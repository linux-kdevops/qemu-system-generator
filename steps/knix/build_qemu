#!/usr/bin/env bash
# SPDX-License-Identifier: copyleft-next-0.3.1
## Usage: steps/knix/build_qemu [--base FILE]
##
## Configure and build QEMU in WORKTREES_DIR/knix/qemu, and install it in
## destdir/ there:
##
##   nix develop ./steps/knix#build-qemu --ignore-env --keep-env-var HOME \
##       --command steps/knix/build_qemu
set -o errexit -o nounset -o pipefail

while [ $# -gt 0 ]; do
	case $1 in
	--base) base=$2 ;;
	*) sed --quiet 's/^## \{0,1\}//p' "$0" >&2 && exit 2 ;;
	esac
	shift 2
done
# shellcheck source=/dev/null
[ -z "${base-}" ] || . "$base"
# shellcheck source=steps/base
. "$(dirname "$0")/../base"

set -o xtrace
cd "$WORKTREES_DIR/knix/qemu"
./configure --target-list=x86_64-softmmu --enable-kvm --enable-slirp --disable-docs
make --jobs="$(nproc)"
make install DESTDIR="$PWD/destdir"
