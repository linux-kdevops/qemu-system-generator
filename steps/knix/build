#!/usr/bin/env bash
# SPDX-License-Identifier: copyleft-next-0.3.1
## Usage: steps/knix/build [--base FILE]
##
## Build, in WORKTREES_DIR/knix, what both knix machines boot: the fast
## kernel, QEMU and BusyBox from steps/knix/flake.nix, linked from nix/,
## the guest's closure, linked as guest/result, and the BusyBox
## initramfs, tiny.cpio:
##
##   nix develop --ignore-env --keep-env-var HOME \
##       --command steps/knix/build
set -o errexit -o nounset -o pipefail

while [ $# -gt 0 ]; do
	case $1 in
	--base) base=$2 ;;
	*) sed --quiet 's/^## \{0,1\}//p' "$0" >&2 && exit 2 ;;
	esac
	shift 2
done
# shellcheck source=/dev/null
[ -z "${base-}" ] || . "$base"
# shellcheck source=steps/base
. "$(dirname "$0")/../base"
flake=$(realpath "$(dirname "$0")")

set -o xtrace
cd "$WORKTREES_DIR/knix"
mkdir --parents nix tiny/bin
# A kernel's modules are an output of their own, linked as -modules.
nix build "$flake#fast-kernel^out,modules" --out-link nix/fast-kernel
nix build "$flake#qemu" --out-link nix/qemu
nix build "$flake#busybox" --out-link nix/busybox
(cd guest && nix build .#toplevel)
install --mode=0755 nix/busybox/bin/busybox tiny/bin/busybox
chmod 0755 tiny tiny/bin
(cd tiny && find . | cpio --quiet --create --format=newc --owner=0:0) >tiny.cpio
