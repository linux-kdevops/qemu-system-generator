#!/usr/bin/env bash
# SPDX-License-Identifier: copyleft-next-0.3.1
## Usage: steps/knix/build [--base FILE]
##
## Build, in WORKTREES_DIR/knix, both kernels, QEMU and BusyBox from
## steps/knix/flake.nix, linked from nix/, the guest's closure, and the
## BusyBox initramfs; then write the drop-ins that hand the closure to the
## two machines: bootstrap through the initramfs, peer through the
## closure's own initrd and init:
##
##   nix develop --ignore-env --keep-env-var HOME \
##       --command steps/knix/build
set -o errexit -o nounset -o pipefail

while [ $# -gt 0 ]; do
	case $1 in
	--base) base=$2 ;;
	*) sed --quiet 's/^## \{0,1\}//p' "$0" >&2 && exit 2 ;;
	esac
	shift 2
done
# shellcheck source=/dev/null
[ -z "${base-}" ] || . "$base"
# shellcheck source=steps/base
. "$(dirname "$0")/../base"
flake=$(realpath "$(dirname "$0")")
units=$HOME/.config/qemu/systemd
files=$(realpath "$(dirname "$0")/files")

set -o xtrace
cd "$WORKTREES_DIR/knix"
mkdir --parents nix tiny/bin "$units/bootstrap.qemu.d" "$units/peer.qemu.d"
# A kernel's modules are an output of their own, linked as -modules.
nix build "$flake#kernel^out,modules" --out-link nix/kernel
nix build "$flake#fast-kernel^out,modules" --out-link nix/fast-kernel
nix build "$flake#qemu" --out-link nix/qemu
nix build "$flake#busybox" --out-link nix/busybox
(cd guest && nix build .#toplevel)
install --mode=0755 nix/busybox/bin/busybox tiny/bin/busybox
chmod 0755 tiny tiny/bin
(cd tiny && find . | cpio --quiet --create --format=newc --owner=0:0) >tiny.cpio
WORKTREES_DIR=$WORKTREES_DIR closure=$(readlink guest/result) \
	envsubst "\$WORKTREES_DIR \$closure" \
	<"$files/10-closure.conf" >"$units/bootstrap.qemu.d/10-closure.conf"
jq --raw-output '."org.nixos.bootspec.v1" |
    "[QEMU]\ninitrd=\(.initrd)\nappend=root=tmpfs console=ttyS0 systemd.hostname=peer init=\(.init)"' \
	guest/result/boot.json >"$units/peer.qemu.d/10-closure.conf"
