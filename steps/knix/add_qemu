#!/usr/bin/env bash
# SPDX-License-Identifier: copyleft-next-0.3.1
## Usage: steps/knix/add_qemu [--base FILE]
##
## Add the QEMU that steps/knix/build_qemu installed to the Nix store with
## the libraries it loads, linked as WORKTREES_DIR/knix/result-qemu:
##
##   nix develop --ignore-env --keep-env-var HOME \
##       --command steps/knix/add_qemu
set -o errexit -o nounset -o pipefail

while [ $# -gt 0 ]; do
	case $1 in
	--base) base=$2 ;;
	*) sed --quiet 's/^## \{0,1\}//p' "$0" >&2 && exit 2 ;;
	esac
	shift 2
done
# shellcheck source=/dev/null
[ -z "${base-}" ] || . "$base"
# shellcheck source=steps/base
. "$(dirname "$0")/../base"
store=$(realpath "$(dirname "$0")/files/store.nix")

set -o xtrace
cd "$WORKTREES_DIR/knix/qemu"
nix build --impure --file "$store" --argstr destdir "$PWD/destdir/usr/local" \
	--out-link ../result-qemu
