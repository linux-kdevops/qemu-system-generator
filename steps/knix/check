#!/usr/bin/env bash
# SPDX-License-Identifier: copyleft-next-0.3.1
## Usage: steps/knix/check [--base FILE]
##
## Log in to the running bootstrap-knix and bootstrap-knix-peer machines, print
## bootstrap-knix's kernel and its virtiofs mounts, check that its root's
## home is the shared home with its systemd directories masked, leave a
## file in WORKTREES_DIR/knix, which must lie in the home, and have each
## machine ping the other over their LAN:
##
##   nix develop --ignore-env --keep-env-var HOME \
##       --command steps/knix/check
set -o errexit -o nounset -o pipefail

while [ $# -gt 0 ]; do
	case $1 in
	--base) base=$2 ;;
	*) sed --quiet 's/^## \{0,1\}//p' "$0" >&2 && exit 2 ;;
	esac
	shift 2
done
# shellcheck source=/dev/null
[ -z "${base-}" ] || . "$base"
# shellcheck source=steps/base
. "$(dirname "$0")/../base"

set -o xtrace
ssh -F "$SSH_DIR/config" bootstrap-knix \
	'uname --kernel-release; findmnt --noheadings --output=TARGET,SOURCE,FSTYPE --types=virtiofs'
rm --force -- "$WORKTREES_DIR/knix/from-guest"
ssh -F "$SSH_DIR/config" bootstrap-knix \
	"pwd && findmnt --mountpoint ~/.config/systemd && findmnt --mountpoint ~/.local/share/systemd && touch $WORKTREES_DIR/knix/from-guest"
ls --format=long "$WORKTREES_DIR/knix/from-guest"
ssh -F "$SSH_DIR/config" bootstrap-knix-peer 'hostname; ping -c 1 10.0.100.49'
ssh -F "$SSH_DIR/config" bootstrap-knix ping -c 1 10.0.100.50
