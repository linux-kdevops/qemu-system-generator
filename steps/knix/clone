#!/usr/bin/env bash
# SPDX-License-Identifier: copyleft-next-0.3.1
## Usage: steps/knix/clone --name TREE [--base FILE]
##
## Clone the release of TREE, linux, qemu or kfragments, that the knix
## guide builds into WORKTREES_DIR/knix/TREE, in place of an earlier clone:
##
##   nix develop --ignore-env --keep-env-var HOME \
##       --command steps/knix/clone --name linux
set -o errexit -o nounset -o pipefail

while [ $# -gt 0 ]; do
	case $1 in
	--name | --base) declare "${1#--}=$2" ;;
	*) sed --quiet 's/^## \{0,1\}//p' "$0" >&2 && exit 2 ;;
	esac
	shift 2
done
: "${name:?}"
# shellcheck source=/dev/null
[ -z "${base-}" ] || . "$base"
# shellcheck source=steps/base
. "$(dirname "$0")/../base"
case $name in
linux) url=https://git.kernel.org/pub/scm/linux/kernel/git/torvalds/linux.git branch=v7.3 ;;
qemu) url=https://gitlab.com/qemu-project/qemu.git branch=v11.1.0 ;;
kfragments) url=https://github.com/linux-kdevops/kfragments.git branch= ;;
*)
	echo "steps/knix/clone: no tree $name" >&2
	exit 2
	;;
esac

set -o xtrace
rm --recursive --force -- "${WORKTREES_DIR:?}/knix/$name"
git clone --depth 1 ${branch:+--branch "$branch"} "$url" "$WORKTREES_DIR/knix/$name"
