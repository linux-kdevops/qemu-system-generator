#!/usr/bin/env bash
# SPDX-License-Identifier: copyleft-next-0.3.1
## Usage: steps/knix/install [--base FILE]
##
## Write, in WORKTREES_DIR/knix, the knix flake of an imageless NixOS
## guest with the public key of SSH_KEY for root, and the init of a
## BusyBox initramfs that mounts the host's Nix store and starts that
## guest's closure; and bootstrap-knix.qemu and bootstrap-knix-peer.qemu in
## ~/.config/qemu/systemd, which boot the kernels and QEMU that
## steps/knix/build links into WORKTREES_DIR/knix/nix, with the store, the
## kernel's modules and the home over virtiofs and a LAN between
## them:
##
##   nix develop --ignore-env --keep-env-var HOME \
##       --command steps/knix/install
set -o errexit -o nounset -o pipefail

while [ $# -gt 0 ]; do
	case $1 in
	--base) base=$2 ;;
	*) sed --quiet 's/^## \{0,1\}//p' "$0" >&2 && exit 2 ;;
	esac
	shift 2
done
# shellcheck source=/dev/null
[ -z "${base-}" ] || . "$base"
# shellcheck source=steps/base
. "$(dirname "$0")/../base"
units=$HOME/.config/qemu/systemd
knix=$WORKTREES_DIR/knix
files=$(realpath "$(dirname "$0")/files")

set -o xtrace
mkdir --parents "$knix/guest" "$knix/tiny" "$units"
cp "$files/guest/flake.nix" "$knix/guest/flake.nix"
key=$(cat "$SSH_KEY.pub") envsubst "\$key" <"$files/guest/default.nix" >"$knix/guest/default.nix"
HOME=$HOME envsubst "\$HOME" <"$files/guest/home.nix" >"$knix/guest/home.nix"
install --mode=0755 "$files/tiny/init" "$knix/tiny/init"
# The fast kernel boots through qboot, the other through QEMU's default
# firmware.
for vm in bootstrap-knix:49:4:fast-kernel:qboot.rom bootstrap-knix-peer:50:2:kernel:; do
	IFS=: read -r name cid cpus kernel bios <<<"$vm"
	knix=$knix cid=$cid cpus=$cpus kernel=$kernel \
		firmware=${bios:+bios=$bios} \
		envsubst "\$knix \$cid \$cpus \$kernel \$firmware" \
		<"$files/machine.qemu" >"$units/$name.qemu"
	rm --recursive --force -- "$units/$name.qemu.d"
done
