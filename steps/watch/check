#!/usr/bin/env bash
# SPDX-License-Identifier: copyleft-next-0.3.1
## Usage: steps/watch/check --description TEXT
##
## Check that the user manager has loaded qemu-system@bootstrap-watch.service
## with the description TEXT:
##
##   nix develop --ignore-env --keep-env-var HOME \
##       --keep-env-var XDG_RUNTIME_DIR \
##       --command steps/watch/check --description first
set -o errexit -o nounset -o pipefail

while [ $# -gt 0 ]; do
	case $1 in
	--description) description=$2 ;;
	*) sed --quiet 's/^## \{0,1\}//p' "$0" >&2 && exit 2 ;;
	esac
	shift 2
done
: "${description:?}"

set -o xtrace
[ "$(systemctl --user show --property=Description --value qemu-system@bootstrap-watch.service)" = "$description" ]
