#!/usr/bin/env bash
# SPDX-License-Identifier: copyleft-next-0.3.1
## Usage: steps/watch/remove_dropin
##
## Remove bootstrap-watch.qemu.d from ~/.config/qemu/systemd, and leave
## the regenerate to the generator's path unit:
##
##   nix develop --ignore-env --keep-env-var HOME \
##       --command steps/watch/remove_dropin
set -o errexit -o nounset -o pipefail

if [ $# -gt 0 ]; then
	sed --quiet 's/^## \{0,1\}//p' "$0" >&2 && exit 2
fi

set -o xtrace
rm --recursive --force -- "$HOME/.config/qemu/systemd/bootstrap-watch.qemu.d"
