#!/usr/bin/env bash
# SPDX-License-Identifier: copyleft-next-0.3.1
## Usage: steps/xfs/check --name VM --version VERSION [--base FILE]
##
## Log in to the running machine VM, check that its xfsprogs is VERSION
## and that xfstests is installed in /var/lib/xfstests:
##
##   nix develop --ignore-env --keep-env-var HOME \
##       --command steps/xfs/check --name bootstrap-mkosi --version 7.1.1
set -o errexit -o nounset -o pipefail

while [ $# -gt 0 ]; do
	case $1 in
	--name | --version | --base) declare "${1#--}=$2" ;;
	*) sed --quiet 's/^## \{0,1\}//p' "$0" >&2 && exit 2 ;;
	esac
	shift 2
done
: "${name:?} ${version:?}"
# shellcheck source=/dev/null
[ -z "${base-}" ] || . "$base"
# shellcheck source=steps/base
. "$(dirname "$0")/../base"

set -o xtrace
ssh -F "$SSH_DIR/config" "$name" \
	"xfs_repair -V | grep --fixed-strings --line-regexp 'xfs_repair version $version' && test -x /var/lib/xfstests/check"
