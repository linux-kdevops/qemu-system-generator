#!/usr/bin/env bash
# SPDX-License-Identifier: copyleft-next-0.3.1
## Usage: steps/xfs/clone --name TREE --tag TAG --guide GUIDE [--base FILE]
##
## Clone TREE, xfsprogs-dev or xfstests-dev, at TAG into
## WORKTREES_DIR/GUIDE/src/TREE, in place of an earlier clone, for the
## guide GUIDE that builds it into its guest:
##
##   nix develop --ignore-env --keep-env-var HOME \
##       --command steps/xfs/clone --name xfsprogs-dev --tag v7.1.1 --guide mkosi
set -o errexit -o nounset -o pipefail

while [ $# -gt 0 ]; do
	case $1 in
	--name | --tag | --guide | --base) declare "${1#--}=$2" ;;
	*) sed --quiet 's/^## \{0,1\}//p' "$0" >&2 && exit 2 ;;
	esac
	shift 2
done
: "${name:?} ${tag:?} ${guide:?}"
# shellcheck source=/dev/null
[ -z "${base-}" ] || . "$base"
# shellcheck source=steps/base
. "$(dirname "$0")/../base"

set -o xtrace
rm --recursive --force -- "${WORKTREES_DIR:?}/$guide/src/$name"
git clone --depth 1 --branch "$tag" "https://git.kernel.org/pub/scm/fs/xfs/$name.git" \
	"$WORKTREES_DIR/$guide/src/$name"
