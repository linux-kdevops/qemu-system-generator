#!/usr/bin/env bash
# SPDX-License-Identifier: copyleft-next-0.3.1
## Usage: steps/kernel/build [--base FILE]
##
## Build the system closure in WORKTREES_DIR/kernel, linked as result, and
## write the drop-ins that hand its init to bootstrap and peer on the
## kernel command line:
##
##   nix develop --ignore-env --keep-env-var HOME \
##       --command steps/kernel/build
set -o errexit -o nounset -o pipefail

while [ $# -gt 0 ]; do
	case $1 in
	--base) base=$2 ;;
	*) sed --quiet 's/^## \{0,1\}//p' "$0" >&2 && exit 2 ;;
	esac
	shift 2
done
# shellcheck source=/dev/null
[ -z "${base-}" ] || . "$base"
# shellcheck source=steps/base
. "$(dirname "$0")/../base"
units=$HOME/.config/qemu/systemd

set -o xtrace
cd "$WORKTREES_DIR/kernel"
nix build
init=$(readlink result)/init
mkdir --parents "$units/bootstrap.qemu.d" "$units/peer.qemu.d"
cat >"$units/bootstrap.qemu.d/10-closure.conf" <<EOF
[QEMU]
append=console=ttyS0 systemd.ssh_listen=vsock::22 init=$init
EOF
cat >"$units/peer.qemu.d/10-closure.conf" <<EOF
[QEMU]
append=console=ttyS0 systemd.hostname=peer systemd.ssh_listen=vsock::22 init=$init
EOF
