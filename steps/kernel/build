#!/usr/bin/env bash
# SPDX-License-Identifier: copyleft-next-0.3.1
## Usage: steps/kernel/build --name VM [--base FILE]
##
## Build the system closure of one machine in WORKTREES_DIR/kernel/VM,
## linked as result, and write the drop-in that hands its init to the
## machine on the kernel command line:
##
##   nix develop --ignore-env --keep-env-var HOME \
##       --command steps/kernel/build --name bootstrap
set -o errexit -o nounset -o pipefail

while [ $# -gt 0 ]; do
	case $1 in
	--name | --base) declare "${1#--}=$2" ;;
	*) sed --quiet 's/^## \{0,1\}//p' "$0" >&2 && exit 2 ;;
	esac
	shift 2
done
: "${name:?}"
# shellcheck source=/dev/null
[ -z "${base-}" ] || . "$base"
# shellcheck source=steps/base
. "$(dirname "$0")/../base"
units=$HOME/.config/qemu/systemd

set -o xtrace
cd "$WORKTREES_DIR/kernel/$name"
nix build
mkdir --parents "$units/$name.qemu.d"
cat >"$units/$name.qemu.d/10-closure.conf" <<EOF
[QEMU]
append=console=ttyS0 systemd.ssh_listen=vsock::22 init=$(readlink result)/init
EOF
