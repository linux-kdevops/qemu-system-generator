#!/usr/bin/env bash
# SPDX-License-Identifier: copyleft-next-0.3.1
## Usage: steps/kernel/install --name VM [--base FILE]
##
## Write the files of one microvm machine, bootstrap or peer: in
## WORKTREES_DIR/kernel/VM, a NixOS flake whose system closure, with the
## latest kernel, the public key of SSH_KEY for root and the machine's
## address on the LAN, the machine boots directly; and in
## ~/.config/qemu/systemd, VM.qemu, which boots it with the host's Nix
## store and SYSTEM_DIR/share over virtiofs and puts it on the LAN:
##
##   nix develop --ignore-env --keep-env-var HOME \
##       --command steps/kernel/install --name bootstrap
set -o errexit -o nounset -o pipefail

while [ $# -gt 0 ]; do
	case $1 in
	--name | --base) declare "${1#--}=$2" ;;
	*) sed --quiet 's/^## \{0,1\}//p' "$0" >&2 && exit 2 ;;
	esac
	shift 2
done
: "${name:?}"
# shellcheck source=/dev/null
[ -z "${base-}" ] || . "$base"
# shellcheck source=steps/base
. "$(dirname "$0")/../base"
units=$HOME/.config/qemu/systemd

# vsock context id, which also ends the LAN MAC and address, and CPUs
case $name in
bootstrap) cid=42 cpus=4 ;;
peer) cid=46 cpus=2 ;;
*)
	echo "steps/kernel/install: no machine $name" >&2
	exit 2
	;;
esac

set -o xtrace
mkdir --parents "$WORKTREES_DIR/kernel/$name" "$units" "$SYSTEM_DIR/share"
cd "$WORKTREES_DIR/kernel/$name"
cat >flake.nix <<EOF
{
  inputs.nixpkgs.url = "github:NixOS/nixpkgs/nixos-unstable";

  outputs =
    { self, nixpkgs }:
    {
      nixosConfigurations.$name = nixpkgs.lib.nixosSystem {
        system = "x86_64-linux";
        modules = [ ./configuration.nix ];
      };
      packages.x86_64-linux.default = self.nixosConfigurations.$name.config.system.build.toplevel;
    };
}
EOF
cat >configuration.nix <<EOF
{ lib, modulesPath, pkgs, ... }:
{
  imports = [ (modulesPath + "/profiles/qemu-guest.nix") ];

  boot.kernelPackages = pkgs.linuxPackages_latest;
  networking.hostName = "$name";
  networking.useNetworkd = true;
  systemd.network.networks."10-lan" = {
    matchConfig.MACAddress = "52:54:00:00:00:$cid";
    address = [ "10.0.100.$cid/24" ];
  };
  services.openssh.enable = true;
  services.openssh.hostKeys = [
    { type = "ed25519"; path = "/etc/ssh/ssh_host_ed25519_key"; }
  ];
  security.pam.services.sshd.startSession = lib.mkForce false;
  users.users.root.openssh.authorizedKeys.keys = [ "$(cat "$SSH_KEY.pub")" ];

  boot.loader.grub.enable = false;
  fileSystems."/" = {
    device = "none";
    fsType = "tmpfs";
    options = [ "mode=0755" ];
  };
  fileSystems."/nix/store" = {
    device = "store";
    fsType = "virtiofs";
  };
  fileSystems."/mnt/host" = {
    device = "host";
    fsType = "virtiofs";
  };

  system.stateVersion = "26.05";
}
EOF
cat >"$units/$name.qemu" <<EOF
[QEMU]
machine=microvm,rtc=on
accel=kvm
cpu=host
m=2G
smp=$cpus
nographic=
serial=mon:stdio
kernel=$WORKTREES_DIR/kernel/$name/result/kernel
initrd=$WORKTREES_DIR/kernel/$name/result/initrd
global=virtio-mmio.force-legacy=false
netdev=user,id=net0
device=virtio-net-device,netdev=net0
netdev=dgram,id=lan,remote.type=inet,remote.host=239.255.0.1,remote.port=5555,local.type=inet,local.host=127.0.0.1,local.port=0
device=virtio-net-device,netdev=lan,mac=52:54:00:00:00:$cid
device=vhost-vsock-device,guest-cid=$cid

[virtiofsd]
shared-dir=/nix/store
tag=store
sandbox=namespace
uid-map=:0:%U:1:
gid-map=:0:%G:1:

[virtiofsd]
shared-dir=$SYSTEM_DIR/share
tag=host
sandbox=namespace
uid-map=:0:%U:1:
gid-map=:0:%G:1:
EOF
rm --recursive --force -- "${units:?}/${name:?}.qemu.d"
