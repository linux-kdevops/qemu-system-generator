# SPDX-License-Identifier: copyleft-next-0.3.1
[QEMU]
machine=q35
nodefaults=
accel=kvm
cpu=host
m=2G
smp=2
nographic=
serial=mon:stdio
kernel=$WORKTREES_DIR/packages/result/kernel
initrd=$WORKTREES_DIR/packages/result/initrd
netdev=user,id=net0
device=virtio-net-pci-non-transitional,netdev=net0,romfile=
device=vhost-vsock-pci-non-transitional,guest-cid=58

[virtiofsd]
shared-dir=/nix/store
tag=store
sandbox=namespace
uid-map=:0:%U:1:
gid-map=:0:%G:1:

[virtiofsd]
shared-dir=%h
tag=home
sandbox=namespace
uid-map=:0:%U:1:
gid-map=:0:%G:1:
