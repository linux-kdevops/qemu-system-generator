#!/usr/bin/env bash
# SPDX-License-Identifier: copyleft-next-0.3.1
## Usage: steps/packages/build [--base FILE]
##
## Build bootstrap-packages' system closure in WORKTREES_DIR/packages,
## linked as result, which the machine's drop-in names:
##
##   nix develop --ignore-env --keep-env-var HOME \
##       --command steps/packages/build
set -o errexit -o nounset -o pipefail

while [ $# -gt 0 ]; do
	case $1 in
	--base) base=$2 ;;
	*) sed --quiet 's/^## \{0,1\}//p' "$0" >&2 && exit 2 ;;
	esac
	shift 2
done
# shellcheck source=/dev/null
[ -z "${base-}" ] || . "$base"
# shellcheck source=steps/base
. "$(dirname "$0")/../base"

set -o xtrace
cd "$WORKTREES_DIR/packages"
nix flake check
nix build
