#!/usr/bin/env bash
# SPDX-License-Identifier: copyleft-next-0.3.1
## Usage: steps/direct/check [--base FILE]
##
## Log in to the running bootstrap and peer machines, print bootstrap's
## kernel, check that its root's home is the shared home with its systemd
## directories masked, leave a file in WORKTREES_DIR/direct, which must
## lie in the home, and have each machine ping the other over their LAN:
##
##   nix develop --ignore-env --keep-env-var HOME \
##       --command steps/direct/check
set -o errexit -o nounset -o pipefail

while [ $# -gt 0 ]; do
	case $1 in
	--base) base=$2 ;;
	*) sed --quiet 's/^## \{0,1\}//p' "$0" >&2 && exit 2 ;;
	esac
	shift 2
done
# shellcheck source=/dev/null
[ -z "${base-}" ] || . "$base"
# shellcheck source=steps/base
. "$(dirname "$0")/../base"

set -o xtrace
ssh -F "$SSH_DIR/config" bootstrap uname --kernel-release
rm --force -- "$WORKTREES_DIR/direct/from-guest"
ssh -F "$SSH_DIR/config" bootstrap \
	"pwd && findmnt --mountpoint ~/.config/systemd && findmnt --mountpoint ~/.local/share/systemd && touch $WORKTREES_DIR/direct/from-guest"
ls --format=long "$WORKTREES_DIR/direct/from-guest"
ssh -F "$SSH_DIR/config" peer 'hostname; ping -c 1 10.0.100.42'
ssh -F "$SSH_DIR/config" bootstrap ping -c 1 10.0.100.46
