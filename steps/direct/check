#!/usr/bin/env bash
# SPDX-License-Identifier: copyleft-next-0.3.1
## Usage: steps/direct/check [--base FILE]
##
## Log in to the running bootstrap-direct and bootstrap-direct-peer machines, print
## bootstrap-direct's kernel, check that its root's home is the shared
## home with its systemd directories and ~/.ssh masked, leave a file in
## WORKTREES_DIR/direct, which must lie in the home, and have each
## machine ping the other over their LAN:
##
##   nix develop --ignore-env --keep-env-var HOME \
##       --command steps/direct/check
set -o errexit -o nounset -o pipefail

while [ $# -gt 0 ]; do
	case $1 in
	--base) base=$2 ;;
	*) sed --quiet 's/^## \{0,1\}//p' "$0" >&2 && exit 2 ;;
	esac
	shift 2
done
# shellcheck source=/dev/null
[ -z "${base-}" ] || . "$base"
# shellcheck source=steps/base
. "$(dirname "$0")/../base"

set -o xtrace
ssh -F "$SSH_DIR/config" bootstrap-direct uname --kernel-release
rm --force -- "$WORKTREES_DIR/direct/from-guest"
ssh -F "$SSH_DIR/config" bootstrap-direct \
	"pwd && findmnt --mountpoint ~/.config/systemd && findmnt --mountpoint ~/.local/share/systemd && findmnt --mountpoint ~/.ssh && touch $WORKTREES_DIR/direct/from-guest"
ls --format=long "$WORKTREES_DIR/direct/from-guest"
ssh -F "$SSH_DIR/config" bootstrap-direct-peer 'hostname; ping -c 1 10.0.100.47'
ssh -F "$SSH_DIR/config" bootstrap-direct ping -c 1 10.0.100.48
