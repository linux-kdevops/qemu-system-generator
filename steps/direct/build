#!/usr/bin/env bash
# SPDX-License-Identifier: copyleft-next-0.3.1
## Usage: steps/direct/build --name VM [--base FILE]
##
## Build the system closure of one machine in WORKTREES_DIR/direct/VM,
## linked as result, copy its initrd to initrd padded to whole pages,
## and write the drop-in that hands its init to the machine on the
## kernel command line:
##
##   nix develop --ignore-env --keep-env-var HOME \
##       --command steps/direct/build --name bootstrap
set -o errexit -o nounset -o pipefail

while [ $# -gt 0 ]; do
	case $1 in
	--name | --base) declare "${1#--}=$2" ;;
	*) sed --quiet 's/^## \{0,1\}//p' "$0" >&2 && exit 2 ;;
	esac
	shift 2
done
: "${name:?}"
# shellcheck source=/dev/null
[ -z "${base-}" ] || . "$base"
# shellcheck source=steps/base
. "$(dirname "$0")/../base"
units=$HOME/.config/qemu/systemd
files=$(realpath "$(dirname "$0")/files")

set -o xtrace
cd "$WORKTREES_DIR/direct/$name"
nix build
# microvm loads the initrd to end in the top page of RAM, under the
# firmware's ACPI tables; whole pages end it below that page.
cp --dereference --force result/initrd initrd
chmod u+w initrd
truncate --size=%4096 initrd
mkdir --parents "$units/$name.qemu.d"
init=$(readlink result)/init envsubst "\$init" \
	<"$files/10-closure.conf" >"$units/$name.qemu.d/10-closure.conf"
