#!/usr/bin/env bash
# SPDX-License-Identifier: copyleft-next-0.3.1
## Usage: steps/direct/install --name VM [--base FILE]
##
## Write the files of one machine, bootstrap-direct or bootstrap-direct-peer: in
## WORKTREES_DIR/direct/VM, a NixOS flake whose system closure, with the
## latest kernel, the public key of SSH_KEY for root and the machine's
## address on the LAN, the machine boots directly; and in
## ~/.config/qemu/systemd, VM.qemu, which boots it with the host's Nix
## store and the home over virtiofs and puts it on the LAN:
##
##   nix develop --ignore-env --keep-env-var HOME \
##       --command steps/direct/install --name bootstrap-direct
set -o errexit -o nounset -o pipefail

while [ $# -gt 0 ]; do
	case $1 in
	--name | --base) declare "${1#--}=$2" ;;
	*) sed --quiet 's/^## \{0,1\}//p' "$0" >&2 && exit 2 ;;
	esac
	shift 2
done
: "${name:?}"
# shellcheck source=/dev/null
[ -z "${base-}" ] || . "$base"
# shellcheck source=steps/base
. "$(dirname "$0")/../base"
units=$HOME/.config/qemu/systemd
files=$(realpath "$(dirname "$0")/files")

# vsock context id, which also ends the LAN MAC and address, and CPUs
case $name in
bootstrap-direct) cid=47 cpus=4 ;;
bootstrap-direct-peer) cid=48 cpus=2 ;;
*)
	echo "steps/direct/install: no machine $name" >&2
	exit 2
	;;
esac

set -o xtrace
mkdir --parents "$WORKTREES_DIR/direct/$name" "$units"
cd "$WORKTREES_DIR/direct/$name"
name=$name envsubst "\$name" <"$files/flake.nix" >flake.nix
name=$name cid=$cid key=$(cat "$SSH_KEY.pub") \
	envsubst "\$name \$cid \$key" <"$files/configuration.nix" >configuration.nix
HOME=$HOME envsubst "\$HOME" <"$files/home.nix" >home.nix
name=$name cid=$cid cpus=$cpus WORKTREES_DIR=$WORKTREES_DIR \
	envsubst "\$name \$cid \$cpus \$WORKTREES_DIR" \
	<"$files/machine.qemu" >"$units/$name.qemu"
rm --recursive --force -- "${units:?}/${name:?}.qemu.d"
