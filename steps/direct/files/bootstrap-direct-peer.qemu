[QEMU]
machine=q35
nodefaults=
accel=kvm
cpu=host
m=2G
smp=$cpus
nographic=
serial=mon:stdio
kernel=$WORKTREES_DIR/direct/$name/result/kernel
initrd=$WORKTREES_DIR/direct/$name/result/initrd
netdev=user,id=net0
device=virtio-net-pci-non-transitional,netdev=net0,romfile=
netdev=dgram,id=lan,remote.type=inet,remote.host=239.255.0.1,remote.port=5556,local.type=inet,local.host=127.0.0.1,local.port=0
device=virtio-net-pci-non-transitional,netdev=lan,mac=52:54:00:00:00:$cid,romfile=
device={"driver": "vhost-vsock-pci-non-transitional", "guest-cid": $cid}

[virtiofsd]
shared-dir=/nix/store
tag=store
sandbox=namespace
uid-map=:0:%U:1:
gid-map=:0:%G:1:

[virtiofsd]
shared-dir=%h
tag=home
sandbox=namespace
uid-map=:0:%U:1:
gid-map=:0:%G:1:
