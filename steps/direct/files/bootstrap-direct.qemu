# SPDX-License-Identifier: copyleft-next-0.3.1
[VM]
SSHPrivateKey=$SSH_KEY

[QEMU]
machine=microvm,rtc=on
nodefaults=
accel=kvm
cpu=host
m=2G
smp=$cpus
nographic=
serial=mon:stdio
kernel=$WORKTREES_DIR/direct/$name/result/kernel
initrd=$WORKTREES_DIR/direct/$name/initrd
global=virtio-mmio.force-legacy=false
netdev=user,id=net0,hostfwd=tcp:127.0.0.1:10047-:22
device=virtio-net-device,netdev=net0
netdev=dgram,id=lan,remote.type=inet,remote.host=239.255.0.1,remote.port=5556,local.type=inet,local.host=127.0.0.1,local.port=0
device=virtio-net-device,netdev=lan,mac=52:54:00:00:00:$cid
device=vhost-vsock-device,guest-cid=$cid
device=virtio-serial-device
chardev=socket,id=console0,path=%t/qemu-system/%i/console.sock,server=on,wait=off
device=virtconsole,chardev=console0

[virtiofsd]
shared-dir=/nix/store
tag=store
cache=always
sandbox=namespace
uid-map=:0:%U:1:
gid-map=:0:%G:1:

[virtiofsd]
shared-dir=%h
tag=home
sandbox=namespace
uid-map=:0:%U:1:
gid-map=:0:%G:1:

[Unit]
Description=NixOS Bootstrap Guest

[Service]
MemoryMax=3G
CPUWeight=50

[Install]
WantedBy=machines.target
