#!/usr/bin/env bash
# SPDX-License-Identifier: copyleft-next-0.3.1
## Usage: steps/nested/build [--base FILE]
##
## In bootstrap-nested's state directory, write the cloud-init seed from
## the files steps/nested/install wrote in WORKTREES_DIR/nested, and a
## fresh 30 GiB disk over the downloaded image, which cloud-init grows
## the root file system into, room for Nix and the generator's closure:
##
##   nix develop --ignore-env --keep-env-var HOME \
##       --command steps/nested/build
set -o errexit -o nounset -o pipefail

while [ $# -gt 0 ]; do
	case $1 in
	--base) base=$2 ;;
	*) sed --quiet 's/^## \{0,1\}//p' "$0" >&2 && exit 2 ;;
	esac
	shift 2
done
# shellcheck source=/dev/null
[ -z "${base-}" ] || . "$base"
# shellcheck source=steps/base
. "$(dirname "$0")/../base"
state=$HOME/.local/state/qemu-system/bootstrap-nested

set -o xtrace
cd "$WORKTREES_DIR/nested"
cloud-localds "$state/seed.iso" user-data meta-data
rm --force -- "$state/disk.qcow2"
qemu-img create --format=qcow2 --backing=debian-14-generic-amd64-daily.qcow2 \
	--backing-format=qcow2 "$state/disk.qcow2" 30G
