#!/usr/bin/env bash
# SPDX-License-Identifier: copyleft-next-0.3.1
## Usage: steps/nested/fetch
##
## Fetch Debian 14's generic cloud image, whose kernel has KVM and
## vhost-vsock for a machine inside it, into the Nix store, pinned with
## its hash in steps/nested/files/image.nix, and link it as image in
## bootstrap-nested's state directory,
## ~/.local/state/qemu-system/bootstrap-nested:
##
##   nix develop --ignore-env --keep-env-var HOME \
##       --command steps/nested/fetch
set -o errexit -o nounset -o pipefail

if [ $# -gt 0 ]; then
	sed --quiet 's/^## \{0,1\}//p' "$0" >&2 && exit 2
fi

state=$HOME/.local/state/qemu-system/bootstrap-nested
files=$(realpath "$(dirname "$0")/files")
set -o xtrace
mkdir --parents "$state"
nix build --file "$files/image.nix" --out-link "$state/image"
