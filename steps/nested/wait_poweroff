#!/usr/bin/env bash
# SPDX-License-Identifier: copyleft-next-0.3.1
## Usage: steps/nested/wait_poweroff [--base FILE]
##
## Succeed once the inner machine of bootstrap-nested has powered off and
## its service ended without a failure, as its init does two minutes
## after it starts:
##
##   nix develop --ignore-env --keep-env-var HOME \
##       --command steps/nested/wait_poweroff
set -o errexit -o nounset -o pipefail

while [ $# -gt 0 ]; do
	case $1 in
	--base) base=$2 ;;
	*) sed --quiet 's/^## \{0,1\}//p' "$0" >&2 && exit 2 ;;
	esac
	shift 2
done
# shellcheck source=/dev/null
[ -z "${base-}" ] || . "$base"
# shellcheck source=steps/base
. "$(dirname "$0")/../base"
guest=(ssh -F "$SSH_DIR/config" bootstrap-nested)

set -o xtrace
[ "$("${guest[@]}" systemctl show --property=ActiveState --value qemu-system@inner.service)" = inactive ]
[ "$("${guest[@]}" systemctl show --property=Result --value qemu-system@inner.service)" = success ]
