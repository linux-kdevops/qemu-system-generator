#!/usr/bin/env bash
# SPDX-License-Identifier: copyleft-next-0.3.1
## Usage: steps/generator/test
##
## Run the generator's unit and integration tests in this checkout with
## the flake shell's Rust toolchain:
##
##   nix develop --ignore-env --keep-env-var HOME \
##       --command steps/generator/test
set -o errexit -o nounset -o pipefail

if [ $# -gt 0 ]; then
	sed --quiet 's/^## \{0,1\}//p' "$0" >&2 && exit 2
fi

set -o xtrace
cd "$(dirname "$0")/../.."
cargo test --locked
