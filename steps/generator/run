#!/usr/bin/env bash
# SPDX-License-Identifier: copyleft-next-0.3.1
## Usage: steps/generator/run
##
## Regenerate the units from the .qemu files and their drop-ins, and wait
## for the generator to finish:
##
##   nix develop --ignore-env --keep-env-var HOME \
##       --keep-env-var XDG_RUNTIME_DIR \
##       --command steps/generator/run
set -o errexit -o nounset -o pipefail

if [ $# -gt 0 ]; then
	sed --quiet 's/^## \{0,1\}//p' "$0" >&2 && exit 2
fi

set -o xtrace
# start would join a run the path unit began before the last write.
systemctl --user restart qemu-system-generator.service
