Include $SSH_DIR/config.d/*.conf

Host bootstrap-disk
    HostName vsock/42
Host cloud-debian
    HostName vsock/43
Host cloud-fedora
    HostName vsock/44
Host cloud-ubuntu
    HostName vsock/45
Host bootstrap-uki
    HostName vsock/46
Host bootstrap-direct
    HostName vsock/47
Host bootstrap-direct-peer
    HostName vsock/48
Host bootstrap-knix
    HostName vsock/49
Host bootstrap-knix-peer
    HostName vsock/50
Host cloud-debian-peer
    HostName vsock/51
Host cloud-fedora-peer
    HostName vsock/52
Host cloud-ubuntu-peer
    HostName vsock/53
Host bootstrap-nested
    HostName vsock/54
Host bootstrap-runner
    HostName vsock/55
Host bootstrap-nvme
    HostName vsock/56
Host bootstrap-virtfs
    HostName vsock/57

Host bootstrap-* cloud-*
    ProxyCommand $proxy %h %p
    ProxyUseFdpass yes
    IdentityFile $SSH_KEY
    IdentitiesOnly yes
    User root
    StrictHostKeyChecking accept-new
    UserKnownHostsFile /dev/null
