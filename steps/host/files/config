Include $SSH_DIR/config.d/*.conf

Host bootstrap
    HostName vsock/42
Host cloud-debian
    HostName vsock/43
Host cloud-fedora
    HostName vsock/44
Host cloud-ubuntu
    HostName vsock/45
Host peer
    HostName vsock/46

Host bootstrap cloud-debian cloud-fedora cloud-ubuntu peer
    ProxyCommand $proxy %h %p
    ProxyUseFdpass yes
    IdentityFile $SSH_KEY
    IdentitiesOnly yes
    User root
    StrictHostKeyChecking accept-new
    UserKnownHostsFile /dev/null
