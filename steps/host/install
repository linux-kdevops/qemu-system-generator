#!/usr/bin/env bash
# SPDX-License-Identifier: copyleft-next-0.3.1
## Usage: steps/host/install [--base FILE]
##
## Write SSH_DIR/config, which names every machine the steps start and
## reaches it over AF_VSOCK through systemd-ssh-proxy. A host without
## /usr/lib/systemd/systemd-ssh-proxy gets the proxy of this shell's
## systemd:
##
##   nix develop --ignore-env --keep-env-var HOME \
##       --command steps/host/install
set -o errexit -o nounset -o pipefail

while [ $# -gt 0 ]; do
	case $1 in
	--base) base=$2 ;;
	*) sed --quiet 's/^## \{0,1\}//p' "$0" >&2 && exit 2 ;;
	esac
	shift 2
done
# shellcheck source=/dev/null
[ -z "${base-}" ] || . "$base"
# shellcheck source=steps/base
. "$(dirname "$0")/../base"
files=$(realpath "$(dirname "$0")/files")

set -o xtrace
proxy=/usr/lib/systemd/systemd-ssh-proxy
[ -x "$proxy" ] ||
	proxy=$(dirname "$(dirname "$(realpath "$(command -v systemctl)")")")/lib/systemd/systemd-ssh-proxy
mkdir --parents "$SSH_DIR/config.d"
SSH_DIR=$SSH_DIR proxy=$proxy SSH_KEY=$SSH_KEY \
	envsubst "\$SSH_DIR \$proxy \$SSH_KEY" <"$files/config" >"$SSH_DIR/config"
chmod go-w "$SSH_DIR/config"
