#!/usr/bin/env bash
# SPDX-License-Identifier: copyleft-next-0.3.1
## Usage: steps/host/install [--base FILE]
##
## Write SSH_DIR/config, which names every machine the steps start and
## reaches it over AF_VSOCK through systemd-ssh-proxy, and make the
## directory the guests share, SYSTEM_DIR/share. A host without
## /usr/lib/systemd/systemd-ssh-proxy gets the proxy of this shell's
## systemd:
##
##   nix develop --ignore-env --keep-env-var HOME \
##       --command steps/host/install
set -o errexit -o nounset -o pipefail

while [ $# -gt 0 ]; do
	case $1 in
	--base) base=$2 ;;
	*) sed --quiet 's/^## \{0,1\}//p' "$0" >&2 && exit 2 ;;
	esac
	shift 2
done
# shellcheck source=/dev/null
[ -z "${base-}" ] || . "$base"
# shellcheck source=steps/base
. "$(dirname "$0")/../base"

set -o xtrace
proxy=/usr/lib/systemd/systemd-ssh-proxy
[ -x "$proxy" ] ||
	proxy=$(dirname "$(dirname "$(realpath "$(command -v systemctl)")")")/lib/systemd/systemd-ssh-proxy
mkdir --parents "$SSH_DIR/config.d" "$SYSTEM_DIR/share"
cat >"$SSH_DIR/config" <<CONFIG
Include $SSH_DIR/config.d/*.conf

Host bootstrap
    HostName vsock/42
Host cloud-debian
    HostName vsock/43
Host cloud-fedora
    HostName vsock/44
Host cloud-ubuntu
    HostName vsock/45
Host peer
    HostName vsock/46

Host bootstrap cloud-debian cloud-fedora cloud-ubuntu peer
    ProxyCommand $proxy %h %p
    ProxyUseFdpass yes
    IdentityFile $SSH_KEY
    IdentitiesOnly yes
    User root
    StrictHostKeyChecking accept-new
    UserKnownHostsFile /dev/null
CONFIG
chmod go-w "$SSH_DIR/config"
