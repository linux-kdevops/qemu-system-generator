#!/usr/bin/env bash
# SPDX-License-Identifier: copyleft-next-0.3.1
## Usage: steps/host/check --output FILE
##
## Print what the guides take from the host: its distribution, kernel,
## systemd, CPUs and memory, and the free disk under HOME and the Nix store.
## Append cpus=<count> to FILE, and fail unless /dev/kvm and
## /dev/vhost-vsock are readable and writable and a user manager answers,
## which docs/bootstrap/ lists under "What you need":
##
##   nix develop .#steps --ignore-env --keep-env-var HOME \
##       --keep-env-var XDG_RUNTIME_DIR \
##       --command steps/host/check --output /dev/stdout
set -o errexit -o nounset -o pipefail

while [ $# -gt 0 ]; do
	case $1 in
	--output) declare "${1#--}=$2" ;;
	*) sed --quiet 's/^## \{0,1\}//p' "$0" >&2 && exit 2 ;;
	esac
	shift 2
done
: "${output:?}"

set -o xtrace
cat /etc/os-release
uname --kernel-release --kernel-version --machine
systemd-detect-virt || true
nproc
free --human
df --human-readable "$HOME" /nix/store
echo "cpus=$(nproc)" >>"$output"
for dev in /dev/kvm /dev/vhost-vsock; do
	if [ ! -r "$dev" ] || [ ! -w "$dev" ]; then
		echo "$(id --user --name) cannot open $dev" >&2
		exit 1
	fi
done
systemctl --user --version
systemctl --user is-system-running || true
