#!/usr/bin/env bash
# SPDX-License-Identifier: copyleft-next-0.3.1
## Usage: steps/runner/install [--base FILE]
##
## Write bootstrap-runner's cloud-init user-data, which gives root the
## public key of SSH_KEY and adds the runner user, uid 1001 with
## passwordless sudo as on GitHub's runners, and its meta-data in
## WORKTREES_DIR/runner; and its .qemu file, sized as ubuntu-latest, in
## ~/.config/qemu/systemd:
##
##   nix develop --ignore-env --keep-env-var HOME \
##       --command steps/runner/install
set -o errexit -o nounset -o pipefail

while [ $# -gt 0 ]; do
	case $1 in
	--base) base=$2 ;;
	*) sed --quiet 's/^## \{0,1\}//p' "$0" >&2 && exit 2 ;;
	esac
	shift 2
done
# shellcheck source=/dev/null
[ -z "${base-}" ] || . "$base"
# shellcheck source=steps/base
. "$(dirname "$0")/../base"
units=$HOME/.config/qemu/systemd
files=$(realpath "$(dirname "$0")/files")

set -o xtrace
mkdir --parents "$WORKTREES_DIR/runner" "$units"
cd "$WORKTREES_DIR/runner"
key=$(cat "$SSH_KEY.pub") envsubst "\$key" <"$files/user-data" >user-data
cp "$files/meta-data" meta-data
rm --recursive --force -- "$units/bootstrap-runner.qemu.d"
cp "$files/machine.qemu" "$units/bootstrap-runner.qemu"
