#!/usr/bin/env bash
# SPDX-License-Identifier: copyleft-next-0.3.1
## Usage: steps/runner/fetch
##
## Fetch into the Nix store the inputs steps/runner/files/images.nix pins,
## Ubuntu 26.04's cloud image and the runner-images release that built
## ubuntu-latest, and link them as image and runner-images.tar.gz in
## bootstrap-runner's state directory,
## ~/.local/state/qemu-system/bootstrap-runner:
##
##   nix develop --ignore-env --keep-env-var HOME \
##       --command steps/runner/fetch
set -o errexit -o nounset -o pipefail

if [ $# -gt 0 ]; then
	sed --quiet 's/^## \{0,1\}//p' "$0" >&2 && exit 2
fi

state=$HOME/.local/state/qemu-system/bootstrap-runner
files=$(realpath "$(dirname "$0")/files")
set -o xtrace
mkdir --parents "$state"
nix build --file "$files/images.nix" ubuntu --out-link "$state/image"
nix build --file "$files/images.nix" runner-images --out-link "$state/runner-images.tar.gz"
