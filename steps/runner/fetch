#!/usr/bin/env bash
# SPDX-License-Identifier: copyleft-next-0.3.1
## Usage: steps/runner/fetch
##
## Download into bootstrap-runner's state directory,
## ~/.local/state/qemu-system/bootstrap-runner, Ubuntu 26.04's cloud
## image, which stands in for the Azure image GitHub's ubuntu-latest
## starts from, and the runner-images release that built ubuntu-latest.
## Each must pass its checksum, and the cloud image is downloaded only if
## the one there fails it:
##
##   nix develop --ignore-env --keep-env-var HOME \
##       --command steps/runner/fetch
set -o errexit -o nounset -o pipefail

if [ $# -gt 0 ]; then
	sed --quiet 's/^## \{0,1\}//p' "$0" >&2 && exit 2
fi

url=https://cloud-images.ubuntu.com/resolute/current
image=resolute-server-cloudimg-amd64.img
images=https://github.com/actions/runner-images/archive/refs/tags/ubuntu26/20261026.180.tar.gz
state=$HOME/.local/state/qemu-system/bootstrap-runner
set -o xtrace
mkdir --parents "$state"
cd "$state"
curl --fail --silent --location "$url/SHA256SUMS" >SHA256SUMS
if ! [ -e "$image" ] || ! sha256sum --check --ignore-missing SHA256SUMS; then
	curl --fail --location --remote-name "$url/$image"
	sha256sum --check --ignore-missing SHA256SUMS
fi
rm -- SHA256SUMS
curl --fail --location --output runner-images.tar.gz "$images"
echo '1708a73c93896a84aa87c78a06da728176326369d3dd6f1d152d40ada180b014  runner-images.tar.gz' |
	sha256sum --check
