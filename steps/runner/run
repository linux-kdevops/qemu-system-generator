#!/usr/bin/env bash
# SPDX-License-Identifier: copyleft-next-0.3.1
## Usage: steps/runner/run [--base FILE]
##
## In the running bootstrap-runner, run the checkout's
## .github/workflows/bootstrap.yaml with act as GitHub's runner runs a
## job: as the runner user in a system service, so with the limits
## runner-images gives services, the environment it writes in
## /etc/environment, and neither a login session nor a terminal. Every
## job runs in the guest itself (-self-hosted), one at a time. Nix's
## profile leads PATH, so a job finds the Nix an earlier one installed
## and install-nix-action leaves it alone, as on a runner that comes with
## Nix:
##
##   nix develop --ignore-env --keep-env-var HOME \
##       --command steps/runner/run
set -o errexit -o nounset -o pipefail

while [ $# -gt 0 ]; do
	case $1 in
	--base) base=$2 ;;
	*) sed --quiet 's/^## \{0,1\}//p' "$0" >&2 && exit 2 ;;
	esac
	shift 2
done
# shellcheck source=/dev/null
[ -z "${base-}" ] || . "$base"
# shellcheck source=steps/base
. "$(dirname "$0")/../base"
work=/home/runner/work/qemu-system-generator/qemu-system-generator
guest=(ssh -F "$SSH_DIR/config" bootstrap-runner)

set -o xtrace
"${guest[@]}" systemd-run --uid=runner --working-directory="$work" \
	--wait --pipe --quiet --collect bash -c "'
	set -o allexport && . /etc/environment && set +o allexport &&
	PATH=/nix/var/nix/profiles/default/bin:\$PATH exec act workflow_dispatch \
		--workflows .github/workflows/bootstrap.yaml \
		--platform ubuntu-latest=-self-hosted --concurrent-jobs 1 \
		--artifact-server-path /home/runner/work/_artifacts'"
