#!/usr/bin/env bash
# SPDX-License-Identifier: copyleft-next-0.3.1
## Usage: steps/runner/build [--base FILE]
##
## In bootstrap-runner's state directory, write the cloud-init seed from
## the files steps/runner/install wrote in WORKTREES_DIR/runner, and a
## fresh disk over the downloaded image, as large as ubuntu-latest's
## root file system, which cloud-init grows into:
##
##   nix develop --ignore-env --keep-env-var HOME \
##       --command steps/runner/build
set -o errexit -o nounset -o pipefail

while [ $# -gt 0 ]; do
	case $1 in
	--base) base=$2 ;;
	*) sed --quiet 's/^## \{0,1\}//p' "$0" >&2 && exit 2 ;;
	esac
	shift 2
done
# shellcheck source=/dev/null
[ -z "${base-}" ] || . "$base"
# shellcheck source=steps/base
. "$(dirname "$0")/../base"
state=$HOME/.local/state/qemu-system/bootstrap-runner

set -o xtrace
cd "$WORKTREES_DIR/runner"
cloud-localds "$state/seed.iso" user-data meta-data
rm --force -- "$state/disk.qcow2"
qemu-img create --format=qcow2 --backing=resolute-server-cloudimg-amd64.img \
	--backing-format=qcow2 "$state/disk.qcow2" 145G
