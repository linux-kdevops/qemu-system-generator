#!/usr/bin/env bash
# SPDX-License-Identifier: copyleft-next-0.3.1
## Usage: steps/mkosi/build [--base FILE]
##
## Build the mkosi guide's image in WORKTREES_DIR/mkosi, in place of the
## last one, from mkosi's cache when it has one. Run it in the shell of
## steps/mkosi/flake.nix:
##
##   nix develop ./steps/mkosi --ignore-env --keep-env-var HOME \
##       --command steps/mkosi/build
set -o errexit -o nounset -o pipefail

while [ $# -gt 0 ]; do
	case $1 in
	--base) base=$2 ;;
	*) sed --quiet 's/^## \{0,1\}//p' "$0" >&2 && exit 2 ;;
	esac
	shift 2
done
# shellcheck source=/dev/null
[ -z "${base-}" ] || . "$base"
# shellcheck source=steps/base
. "$(dirname "$0")/../base"

set -o xtrace
cd "$WORKTREES_DIR/mkosi"
mkosi --force build
