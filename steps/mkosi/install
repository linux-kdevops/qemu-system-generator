#!/usr/bin/env bash
# SPDX-License-Identifier: copyleft-next-0.3.1
## Usage: steps/mkosi/install [--base FILE]
##
## Write the mkosi guide's image configuration, with root's key from
## SSH_KEY, and its build script in WORKTREES_DIR/mkosi, link Debian's
## archive keyring and OVMF there, and write bootstrap-mkosi.qemu in
## ~/.config/qemu/systemd:
##
##   nix develop --ignore-env --keep-env-var HOME \
##       --command steps/mkosi/install
set -o errexit -o nounset -o pipefail

while [ $# -gt 0 ]; do
	case $1 in
	--base) base=$2 ;;
	*) sed --quiet 's/^## \{0,1\}//p' "$0" >&2 && exit 2 ;;
	esac
	shift 2
done
# shellcheck source=/dev/null
[ -z "${base-}" ] || . "$base"
# shellcheck source=steps/base
. "$(dirname "$0")/../base"
here=$(realpath "$(dirname "$0")")
dir=$WORKTREES_DIR/mkosi

set -o xtrace
mkdir --parents "$dir/mkosi.extra/root/.ssh" "$HOME/.config/qemu/systemd"
cp "$here/files/mkosi.conf" "$here/files/mkosi.build.chroot" "$dir/"
cp "$SSH_KEY.pub" "$dir/mkosi.extra/root/.ssh/authorized_keys"
nix build "$here#keyring" --out-link "$dir/keyring"
nix build "$here#ovmf" --out-link "$dir/ovmf"
WORKTREES_DIR=$WORKTREES_DIR SSH_KEY=$SSH_KEY envsubst "\$WORKTREES_DIR \$SSH_KEY" \
	<"$here/files/bootstrap-mkosi.qemu" >"$HOME/.config/qemu/systemd/bootstrap-mkosi.qemu"
