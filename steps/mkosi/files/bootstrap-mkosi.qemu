# SPDX-License-Identifier: copyleft-next-0.3.1
[VM]
SSHPrivateKey=$SSH_KEY

[QEMU]
machine=q35
accel=kvm
cpu=host
m=2G
smp=4
nographic=
serial=mon:stdio
drive=if=pflash,format=raw,readonly=on,file=$WORKTREES_DIR/mkosi/ovmf-fd/FV/OVMF_CODE.fd
drive=if=pflash,format=raw,snapshot=on,file=$WORKTREES_DIR/mkosi/ovmf-fd/FV/OVMF_VARS.fd
drive=file=$WORKTREES_DIR/mkosi/mkosi.output/bootstrap.raw,if=virtio,format=raw,snapshot=on
device=vhost-vsock-pci-non-transitional,guest-cid=59
