#!/usr/bin/env bash
# SPDX-License-Identifier: copyleft-next-0.3.1
## Usage: steps/uki/check [--base FILE]
##
## Log in to the running bootstrap machine, print its kernel, have it read
## the host's file from the share and leave one there, and find that file
## in SYSTEM_DIR/share:
##
##   nix develop --ignore-env --keep-env-var HOME \
##       --command steps/uki/check
set -o errexit -o nounset -o pipefail

while [ $# -gt 0 ]; do
	case $1 in
	--base) base=$2 ;;
	*) sed --quiet 's/^## \{0,1\}//p' "$0" >&2 && exit 2 ;;
	esac
	shift 2
done
# shellcheck source=/dev/null
[ -z "${base-}" ] || . "$base"
# shellcheck source=steps/base
. "$(dirname "$0")/../base"

set -o xtrace
rm --force -- "$SYSTEM_DIR/share/from-guest"
ssh -F "$SSH_DIR/config" bootstrap uname -r
ssh -F "$SSH_DIR/config" bootstrap 'cat /mnt/host/hello.txt; touch /mnt/host/from-guest'
ls --format=long "$SYSTEM_DIR/share/from-guest"
