# SPDX-License-Identifier: copyleft-next-0.3.1
[QEMU]
machine=q35
accel=kvm
cpu=host
m=2G
smp=4
nographic=
serial=mon:stdio
drive=if=pflash,format=raw,readonly=on,file=$WORKTREES_DIR/uki/ovmf-fd/FV/OVMF_CODE.fd
drive=if=pflash,format=raw,snapshot=on,file=$WORKTREES_DIR/uki/ovmf-fd/FV/OVMF_VARS.fd
nic=user,model=virtio-net-pci-non-transitional
device=vhost-vsock-pci-non-transitional,guest-cid=46

[virtiofsd]
shared-dir=$WORKTREES_DIR/uki/result/
tag=esp
sandbox=namespace
uid-map=:0:%U:1:
gid-map=:0:%G:1:

[virtiofsd]
shared-dir=/nix/store
tag=store
cache=always
sandbox=namespace
uid-map=:0:%U:1:
gid-map=:0:%G:1:

[virtiofsd]
shared-dir=%h
tag=home
sandbox=namespace
uid-map=:0:%U:1:
gid-map=:0:%G:1:
