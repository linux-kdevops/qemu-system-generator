#!/usr/bin/env bash
# SPDX-License-Identifier: copyleft-next-0.3.1
## Usage: steps/uki/build [--base FILE]
##
## Build the EFI system partition and the OVMF firmware that bootstrap-uki.qemu
## boots, linked as result and ovmf-fd in WORKTREES_DIR/uki:
##
##   nix develop --ignore-env --keep-env-var HOME \
##       --command steps/uki/build
set -o errexit -o nounset -o pipefail

while [ $# -gt 0 ]; do
	case $1 in
	--base) base=$2 ;;
	*) sed --quiet 's/^## \{0,1\}//p' "$0" >&2 && exit 2 ;;
	esac
	shift 2
done
# shellcheck source=/dev/null
[ -z "${base-}" ] || . "$base"
# shellcheck source=steps/base
. "$(dirname "$0")/../base"

set -o xtrace
cd "$WORKTREES_DIR/uki"
nix build .#ovmf --out-link ovmf
nix build
