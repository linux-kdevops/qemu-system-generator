#!/usr/bin/env bash
# SPDX-License-Identifier: copyleft-next-0.3.1
## Usage: steps/libguestfs/fetch
##
## Fetch the Debian cloud image steps/cloud/files/images.nix pins into the
## Nix store, link it as image in bootstrap-libguestfs's state directory,
## ~/.local/state/qemu-system/bootstrap-libguestfs, and copy it there as
## bootstrap.qcow2, the disk virt-customize changes:
##
##   nix develop --ignore-env --keep-env-var HOME \
##       --command steps/libguestfs/fetch
set -o errexit -o nounset -o pipefail

if [ $# -gt 0 ]; then
	sed --quiet 's/^## \{0,1\}//p' "$0" >&2 && exit 2
fi

state=$HOME/.local/state/qemu-system/bootstrap-libguestfs
images=$(realpath "$(dirname "$0")/../cloud/files/images.nix")

set -o xtrace
mkdir --parents "$state"
nix build --file "$images" --argstr distro debian --argstr version 14 --out-link "$state/image"
cp --no-preserve=mode "$state/image" "$state/bootstrap.qcow2"
