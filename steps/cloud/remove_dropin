#!/usr/bin/env bash
# SPDX-License-Identifier: copyleft-next-0.3.1
## Usage: steps/cloud/remove_dropin
##
## Remove cloud-.qemu.d, the drop-in steps/cloud/install wrote for every
## cloud-* machine, from ~/.config/qemu/systemd once the machines are gone,
## and regenerate:
##
##   nix develop --ignore-env --keep-env-var HOME \
##       --keep-env-var XDG_RUNTIME_DIR \
##       --command steps/cloud/remove_dropin
set -o errexit -o nounset -o pipefail

if [ $# -gt 0 ]; then
	sed --quiet 's/^## \{0,1\}//p' "$0" >&2 && exit 2
fi
units=$HOME/.config/qemu/systemd

set -o xtrace
rm --recursive --force -- "$units/cloud-.qemu.d"
# start would join a run the path unit began before the last write.
systemctl --user restart qemu-system-generator.service
