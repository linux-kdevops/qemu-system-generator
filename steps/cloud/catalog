# shellcheck shell=bash
# The step that reads this file sets name and uses the rest.
# shellcheck disable=SC2034,SC2154
# The vsock context id also ends the LAN MAC and address.

case $name in
cloud-debian) cid=43 ;;
cloud-fedora) cid=44 ;;
cloud-ubuntu) cid=45 ;;
cloud-debian-peer) cid=51 ;;
cloud-fedora-peer) cid=52 ;;
cloud-ubuntu-peer) cid=53 ;;
*)
	echo "steps/cloud/catalog: no machine $name" >&2
	exit 2
	;;
esac
distro=${name#cloud-}
distro=${distro%-peer}
