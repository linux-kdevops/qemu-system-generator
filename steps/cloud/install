#!/usr/bin/env bash
# SPDX-License-Identifier: copyleft-next-0.3.1
## Usage: steps/cloud/install --distro NAME --version VERSION [--base FILE]
##
## For one release of steps/cloud/catalog, write the cloud-init user-data
## that gives root the public key of SSH_KEY, and the network configuration
## of a machine on the LAN, in WORKTREES_DIR/cloud; and in
## ~/.config/qemu/systemd, the machine's .qemu file, the drop-in every cloud
## machine shares, and the drop-in that puts a machine on the LAN:
##
##   nix develop --ignore-env --keep-env-var HOME \
##       --command steps/cloud/install --distro debian --version 14
set -o errexit -o nounset -o pipefail

while [ $# -gt 0 ]; do
	case $1 in
	--distro | --version | --base) declare "${1#--}=$2" ;;
	*) sed --quiet 's/^## \{0,1\}//p' "$0" >&2 && exit 2 ;;
	esac
	shift 2
done
: "${distro:?} ${version:?}"
# shellcheck source=/dev/null
[ -z "${base-}" ] || . "$base"
# shellcheck source=steps/base
. "$(dirname "$0")/../base"
# shellcheck source=steps/cloud/catalog
. "$(dirname "$0")/catalog"
units=$HOME/.config/qemu/systemd

set -o xtrace
mkdir --parents "$WORKTREES_DIR/cloud" "$units/cloud-.qemu.d"
cd "$WORKTREES_DIR/cloud"
cat >user-data <<EOF
#cloud-config
disable_root: false
ssh_authorized_keys:
  - $(cat "$SSH_KEY.pub")
EOF
cat >"$units/cloud-.qemu.d/10-cloud.conf" <<'EOF'
[QEMU]
machine=q35
accel=kvm
cpu=host
m=2G
smp=2
nographic=
serial=mon:stdio
drive=file=seed.iso,if=virtio,format=raw,readonly=on
nic=user,model=virtio-net-pci-non-transitional
EOF
cat >"$units/$name.qemu" <<EOF
[QEMU]
drive=file=$image,if=virtio,format=qcow2
device=vhost-vsock-pci-non-transitional,guest-cid=$cid
EOF
rm --recursive --force -- "$units/$name.qemu.d"
if $lan; then
	cat >"$name.network" <<EOF
version: 2
ethernets:
  user:
    match:
      macaddress: "52:54:00:12:34:56"
    dhcp4: true
  lan:
    match:
      macaddress: "52:54:00:00:00:$cid"
    addresses: [10.0.100.$cid/24]
EOF
	mkdir --parents "$units/$name.qemu.d"
	cat >"$units/$name.qemu.d/20-lan.conf" <<EOF
[QEMU]
netdev=dgram,id=lan,remote.type=inet,remote.host=239.255.0.1,remote.port=5555,local.type=inet,local.host=127.0.0.1,local.port=0
device=virtio-net-pci-non-transitional,netdev=lan,mac=52:54:00:00:00:$cid
EOF
fi
