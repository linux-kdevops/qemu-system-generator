#!/usr/bin/env bash
# SPDX-License-Identifier: copyleft-next-0.3.1
## Usage: steps/cloud/build --name VM --version VERSION [--base FILE]
##
## Write the cloud-init seed of one machine of steps/cloud/catalog into its
## state directory, from the files steps/cloud/install wrote in
## WORKTREES_DIR/cloud:
##
##   nix develop --ignore-env --keep-env-var HOME \
##       --command steps/cloud/build --name cloud-debian --version 14
set -o errexit -o nounset -o pipefail

while [ $# -gt 0 ]; do
	case $1 in
	--name | --version | --base) declare "${1#--}=$2" ;;
	*) sed --quiet 's/^## \{0,1\}//p' "$0" >&2 && exit 2 ;;
	esac
	shift 2
done
: "${name:?} ${version:?}"
# shellcheck source=/dev/null
[ -z "${base-}" ] || . "$base"
# shellcheck source=steps/base
. "$(dirname "$0")/../base"
# shellcheck source=steps/cloud/catalog
. "$(dirname "$0")/catalog"
state=$HOME/.local/state/qemu-system/$name
files=$(realpath "$(dirname "$0")/files")

set -o xtrace
cd "$WORKTREES_DIR/cloud"
instance=$name host=$name envsubst "\$instance \$host" <"$files/meta-data" >"$name.meta-data"
cloud-localds --network-config="$name.network" \
	"$state/seed.iso" user-data "$name.meta-data"
