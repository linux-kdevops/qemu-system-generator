#!/usr/bin/env bash
# SPDX-License-Identifier: copyleft-next-0.3.1
## Usage: steps/cloud/fetch --distro NAME --version VERSION
##
## Download the cloud image of one distribution release into the state
## directory of its machine, ~/.local/state/qemu-system/cloud-NAME, unless
## the image already there passes its publisher's checksum. The releases
## are those of steps/cloud/catalog:
##
##   nix develop --ignore-env --keep-env-var HOME \
##       --command steps/cloud/fetch --distro debian --version 14
set -o errexit -o nounset -o pipefail

while [ $# -gt 0 ]; do
	case $1 in
	--distro | --version) declare "${1#--}=$2" ;;
	*) sed --quiet 's/^## \{0,1\}//p' "$0" >&2 && exit 2 ;;
	esac
	shift 2
done
: "${distro:?} ${version:?}"

# shellcheck source=steps/cloud/catalog
. "$(dirname "$0")/catalog"
state=$HOME/.local/state/qemu-system/$name

set -o xtrace
mkdir --parents "$state"
cd "$state"
curl --fail --silent --location "$sums_url" >"$name.sums"
if ! [ -e "$image" ] || ! "$sums" --check --ignore-missing "$name.sums"; then
	curl --fail --location --remote-name "$image_url"
	"$sums" --check --ignore-missing "$name.sums"
fi
rm -- "$name.sums"
