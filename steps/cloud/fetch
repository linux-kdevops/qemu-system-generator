#!/usr/bin/env bash
# SPDX-License-Identifier: copyleft-next-0.3.1
## Usage: steps/cloud/fetch --name VM --version VERSION
##
## Download the cloud image of one machine of steps/cloud/catalog, in the
## distribution release VERSION, into its state directory,
## ~/.local/state/qemu-system/VM, unless the image already there passes its
## publisher's checksum:
##
##   nix develop --ignore-env --keep-env-var HOME \
##       --command steps/cloud/fetch --name cloud-debian --version 14
set -o errexit -o nounset -o pipefail

while [ $# -gt 0 ]; do
	case $1 in
	--name | --version) declare "${1#--}=$2" ;;
	*) sed --quiet 's/^## \{0,1\}//p' "$0" >&2 && exit 2 ;;
	esac
	shift 2
done
: "${name:?} ${version:?}"

# shellcheck source=steps/cloud/catalog
. "$(dirname "$0")/catalog"
state=$HOME/.local/state/qemu-system/$name

set -o xtrace
mkdir --parents "$state"
cd "$state"
curl --fail --silent --location "$sums_url" >"$name.sums"
if ! [ -e "$image" ] || ! "$sums" --check --ignore-missing "$name.sums"; then
	curl --fail --location --remote-name "$image_url"
	"$sums" --check --ignore-missing "$name.sums"
fi
rm -- "$name.sums"
