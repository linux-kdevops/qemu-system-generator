#!/usr/bin/env bash
# SPDX-License-Identifier: copyleft-next-0.3.1
## Usage: steps/cloud/fetch --name VM --version VERSION
##
## Fetch the cloud image of one machine of steps/cloud/catalog, in the
## distribution release VERSION, into the Nix store, pinned with its hash
## in steps/cloud/files/images.nix, and link it as image in the machine's
## state directory, ~/.local/state/qemu-system/VM:
##
##   nix develop --ignore-env --keep-env-var HOME \
##       --command steps/cloud/fetch --name cloud-debian --version 14
set -o errexit -o nounset -o pipefail

while [ $# -gt 0 ]; do
	case $1 in
	--name | --version) declare "${1#--}=$2" ;;
	*) sed --quiet 's/^## \{0,1\}//p' "$0" >&2 && exit 2 ;;
	esac
	shift 2
done
: "${name:?} ${version:?}"

# shellcheck source=steps/cloud/catalog
. "$(dirname "$0")/catalog"
state=$HOME/.local/state/qemu-system/$name
files=$(realpath "$(dirname "$0")/files")

set -o xtrace
mkdir --parents "$state"
nix build --file "$files/images.nix" --argstr distro "$distro" --argstr version "$version" \
	--out-link "$state/image"
