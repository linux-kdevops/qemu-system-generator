#!/usr/bin/env bash
# SPDX-License-Identifier: copyleft-next-0.3.1
## Usage: steps/cloud/check [--base FILE]
##
## Log in to the three running cloud machines, print each one's host name
## and kernel, and have Debian and Fedora ping each other over their LAN:
##
##   nix develop --ignore-env --keep-env-var HOME \
##       --command steps/cloud/check
set -o errexit -o nounset -o pipefail

while [ $# -gt 0 ]; do
	case $1 in
	--base) base=$2 ;;
	*) sed --quiet 's/^## \{0,1\}//p' "$0" >&2 && exit 2 ;;
	esac
	shift 2
done
# shellcheck source=/dev/null
[ -z "${base-}" ] || . "$base"
# shellcheck source=steps/base
. "$(dirname "$0")/../base"

set -o xtrace
for vm in cloud-debian cloud-fedora cloud-ubuntu; do
	ssh -F "$SSH_DIR/config" "$vm" 'hostname; uname -r'
done
ssh -F "$SSH_DIR/config" cloud-debian ping -c 1 10.0.100.44
ssh -F "$SSH_DIR/config" cloud-fedora ping -c 1 10.0.100.43
