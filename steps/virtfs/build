#!/usr/bin/env bash
# SPDX-License-Identifier: copyleft-next-0.3.1
## Usage: steps/virtfs/build [--base FILE]
##
## Build bootstrap-virtfs's system closure in WORKTREES_DIR/virtfs,
## linked as result; write the drop-in that hands its init to the
## kernel; and make fresh share directories in WORKTREES_DIR/virtfs/shares,
## empty but for a file from the host in the read-only one:
##
##   nix develop --ignore-env --keep-env-var HOME \
##       --command steps/virtfs/build
set -o errexit -o nounset -o pipefail

while [ $# -gt 0 ]; do
	case $1 in
	--base) base=$2 ;;
	*) sed --quiet 's/^## \{0,1\}//p' "$0" >&2 && exit 2 ;;
	esac
	shift 2
done
# shellcheck source=/dev/null
[ -z "${base-}" ] || . "$base"
# shellcheck source=steps/base
. "$(dirname "$0")/../base"
units=$HOME/.config/qemu/systemd
files=$(realpath "$(dirname "$0")/files")

set -o xtrace
cd "$WORKTREES_DIR/virtfs"
nix build
mkdir --parents "$units/bootstrap-virtfs.qemu.d"
closure=$(readlink result) envsubst "\$closure" \
	<"$files/10-closure.conf" >"$units/bootstrap-virtfs.qemu.d/10-closure.conf"
rm --recursive --force -- shares
mkdir --parents shares/none shares/xattr shares/file shares/ro shares/writeout shares/shorthand
echo from-host >shares/ro/from-host
