#!/usr/bin/env bash
# SPDX-License-Identifier: copyleft-next-0.3.1
## Usage: steps/virtfs/install [--base FILE]
##
## Write bootstrap-virtfs's files: in WORKTREES_DIR/virtfs, a NixOS
## flake whose system closure, with the public key of SSH_KEY for root,
## the machine boots directly; and in ~/.config/qemu/systemd,
## bootstrap-virtfs.qemu, which boots it:
##
##   nix develop --ignore-env --keep-env-var HOME \
##       --command steps/virtfs/install
set -o errexit -o nounset -o pipefail

while [ $# -gt 0 ]; do
	case $1 in
	--base) base=$2 ;;
	*) sed --quiet 's/^## \{0,1\}//p' "$0" >&2 && exit 2 ;;
	esac
	shift 2
done
# shellcheck source=/dev/null
[ -z "${base-}" ] || . "$base"
# shellcheck source=steps/base
. "$(dirname "$0")/../base"
units=$HOME/.config/qemu/systemd
files=$(realpath "$(dirname "$0")/files")

set -o xtrace
mkdir --parents "$WORKTREES_DIR/virtfs" "$units"
cd "$WORKTREES_DIR/virtfs"
cp "$files/flake.nix" flake.nix
key=$(cat "$SSH_KEY.pub") envsubst "\$key" <"$files/configuration.nix" >configuration.nix
WORKTREES_DIR=$WORKTREES_DIR envsubst "\$WORKTREES_DIR" \
	<"$files/bootstrap-virtfs.qemu" >"$units/bootstrap-virtfs.qemu"
