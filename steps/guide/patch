"""Usage: steps/guide/patch --file FILE < DIFF

Apply a diff block of docs/bootstrap/ to FILE. The guides' diffs carry no
line numbers: a context line or a - line is found at or after the previous
one, a + line goes in after it, a - line goes out, and "..." or an empty
line skips ahead. Fail when a context or - line is not there, which means
the guide and the file it changes disagree:

  steps/guide/patch --file ~/bootstrap/kernel/virtiofs.nix <<'EOF'
     fileSystems."/nix/store" = {
  +  fileSystems."/mnt/host" = {
  EOF
"""

import sys


def main(argv):
    if len(argv) != 2 or argv[0] != "--file":
        sys.stderr.write(__doc__)
        sys.exit(2)
    path = argv[1]
    with open(path) as f:
        lines = f.read().split("\n")
    if lines and lines[-1] == "":
        lines.pop()
    pos = 0
    for line in sys.stdin.read().split("\n"):
        if line in ("", "..."):
            continue
        tag, text = line[0], line[1:]
        if tag == "+":
            lines.insert(pos, text)
            pos += 1
        elif tag in (" ", "-"):
            try:
                found = lines.index(text, pos)
            except ValueError:
                sys.exit(f"{path}: not found after line {pos}: {text!r}")
            if tag == "-":
                del lines[found]
                pos = found
            else:
                pos = found + 1
        else:
            sys.exit(f"{path}: not a diff line: {line!r}")
    with open(path, "w") as f:
        f.write("\n".join(lines) + "\n")


if __name__ == "__main__":
    main(sys.argv[1:])
