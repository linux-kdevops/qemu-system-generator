#!/usr/bin/env bash
# SPDX-License-Identifier: copyleft-next-0.3.1
## Usage: steps/guide/clean --dir DIR
##
## Remove DIR, a guide's directory under ~/bootstrap, so that the guide
## starts from the empty host it assumes: knix clones into it and runs nix
## flake init there, which refuse a directory that is already filled.
## Anything outside ~/bootstrap is refused:
##
##   nix develop --ignore-env --keep-env-var HOME \
##       --command steps/guide/clean --dir ~/bootstrap/knix
set -o errexit -o nounset -o pipefail

while [ $# -gt 0 ]; do
	case $1 in
	--dir) declare "${1#--}=$2" ;;
	*) sed --quiet 's/^## \{0,1\}//p' "$0" >&2 && exit 2 ;;
	esac
	shift 2
done
: "${dir:?}"

set -o xtrace
dir=$(realpath --canonicalize-missing "$dir")
case $dir in
"$HOME"/bootstrap/?*) ;;
*)
	echo "$dir is not under $HOME/bootstrap" >&2
	exit 1
	;;
esac
rm --recursive --force "$dir"
