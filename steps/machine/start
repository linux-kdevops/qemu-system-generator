#!/usr/bin/env bash
# SPDX-License-Identifier: copyleft-next-0.3.1
## Usage: steps/machine/start --name "VM..."
##
## Regenerate the units from the .qemu files and restart
## qemu-system@VM.service of each machine in the space-separated list.
## The service is up once QEMU runs; steps/machine/wait says when the
## guest is:
##
##   nix develop --ignore-env --keep-env-var HOME \
##       --keep-env-var XDG_RUNTIME_DIR \
##       --command steps/machine/start --name bootstrap
set -o errexit -o nounset -o pipefail

while [ $# -gt 0 ]; do
	case $1 in
	--name) name=$2 ;;
	*) sed --quiet 's/^## \{0,1\}//p' "$0" >&2 && exit 2 ;;
	esac
	shift 2
done
: "${name:?}"

set -o xtrace
# start would join a run the path unit began before the last write.
systemctl --user restart qemu-system-generator.service
for vm in $name; do
	systemctl --user restart "qemu-system@$vm.service"
done
