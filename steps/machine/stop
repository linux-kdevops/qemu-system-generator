#!/usr/bin/env bash
# SPDX-License-Identifier: copyleft-next-0.3.1
## Usage: steps/machine/stop --name VM
##
## Stop qemu-system@VM.service the way the guides do, which powers the
## guest down, and fail unless the service ended with Result=success,
## which a guest that ignored the power button and was killed at
## TimeoutStopSec= does not:
##
##   nix develop --ignore-env --keep-env-var HOME \
##       --keep-env-var XDG_RUNTIME_DIR \
##       --command steps/machine/stop --name bootstrap
set -o errexit -o nounset -o pipefail

while [ $# -gt 0 ]; do
	case $1 in
	--name) name=$2 ;;
	*) sed --quiet 's/^## \{0,1\}//p' "$0" >&2 && exit 2 ;;
	esac
	shift 2
done
: "${name:?}"

set -o xtrace
start=$SECONDS
systemctl --user stop "qemu-system@$name.service"
echo "$name: stopped in $((SECONDS - start)) s"
result=$(systemctl --user show --property=Result --value "qemu-system@$name.service")
[ "$result" = success ]
