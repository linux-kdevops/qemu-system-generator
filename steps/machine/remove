#!/usr/bin/env bash
# SPDX-License-Identifier: copyleft-next-0.3.1
## Usage: steps/machine/remove --name "VM..." [--ssh-dir DIR]
##
## Remove what a guide wrote for each machine VM in the space-separated
## list, as docs/bootstrap/index.rst asks before a second guide: kill
## qemu-system@VM.service if it runs (QEMU exits on SIGTERM, as
## docs/bootstrap/_kill.rst shows), then remove ~/.config/qemu/systemd/VM.qemu,
## VM.qemu.d/ and DIR/config.d/VM.conf (DIR defaults to ~/bootstrap/ssh),
## and regenerate:
##
##   nix develop --ignore-env --keep-env-var HOME \
##       --keep-env-var XDG_RUNTIME_DIR \
##       --command steps/machine/remove --name bootstrap
set -o errexit -o nounset -o pipefail

ssh_dir=$HOME/bootstrap/ssh
while [ $# -gt 0 ]; do
	case $1 in
	--name | --ssh-dir)
		opt=${1#--}
		declare "${opt//-/_}=$2"
		;;
	*) sed --quiet 's/^## \{0,1\}//p' "$0" >&2 && exit 2 ;;
	esac
	shift 2
done
: "${name:?}"

set -o xtrace
for vm in $name; do
	if systemctl --user is-active --quiet "qemu-system@$vm.service"; then
		systemctl --user kill "qemu-system@$vm.service"
		while systemctl --user is-active --quiet "qemu-system@$vm.service"; do
			sleep 1
		done
	fi
	rm --recursive --force "$HOME/.config/qemu/systemd/$vm.qemu" \
		"$HOME/.config/qemu/systemd/$vm.qemu.d" "$ssh_dir/config.d/$vm.conf"
done
systemctl --user start qemu-system-generator.service
for vm in $name; do
	systemctl --user reset-failed "qemu-system@$vm.service" 2>/dev/null || true
done
