#!/usr/bin/env bash
# SPDX-License-Identifier: copyleft-next-0.3.1
## Usage: steps/machine/remove --name VM
##
## Remove a machine the way the guides do: stop qemu-system@VM.service,
## delete its state directory while the unit still loads, remove VM.qemu
## and VM.qemu.d from ~/.config/qemu/systemd, and regenerate:
##
##   nix develop --ignore-env --keep-env-var HOME \
##       --keep-env-var XDG_RUNTIME_DIR \
##       --command steps/machine/remove --name bootstrap-disk
set -o errexit -o nounset -o pipefail

while [ $# -gt 0 ]; do
	case $1 in
	--name) name=$2 ;;
	*) sed --quiet 's/^## \{0,1\}//p' "$0" >&2 && exit 2 ;;
	esac
	shift 2
done
: "${name:?}"
units=$HOME/.config/qemu/systemd

set -o xtrace
systemctl --user stop "qemu-system@$name.service"
systemctl --user clean --what=state "qemu-system@$name.service"
rm --recursive --force -- "$units/$name.qemu" "$units/$name.qemu.d"
# start would join a run the path unit began before the last write.
systemctl --user restart qemu-system-generator.service
