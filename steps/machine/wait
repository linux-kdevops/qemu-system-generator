#!/usr/bin/env bash
# SPDX-License-Identifier: copyleft-next-0.3.1
## Usage: steps/machine/wait --name "VM..." [--base FILE]
##
## Ask each machine in the space-separated list over SSH whether its
## systemd has finished starting up, and wait for the answer. A guest that
## comes up degraded counts as up; one that does not answer yet fails, so
## run it again until it passes:
##
##   nix develop --ignore-env --keep-env-var HOME \
##       --command steps/machine/wait --name bootstrap
set -o errexit -o nounset -o pipefail

while [ $# -gt 0 ]; do
	case $1 in
	--name | --base) declare "${1#--}=$2" ;;
	*) sed --quiet 's/^## \{0,1\}//p' "$0" >&2 && exit 2 ;;
	esac
	shift 2
done
: "${name:?}"
# shellcheck source=/dev/null
[ -z "${base-}" ] || . "$base"
# shellcheck source=steps/base
. "$(dirname "$0")/../base"

set -o xtrace
for vm in $name; do
	state=$(ssh -F "$SSH_DIR/config" "$vm" systemctl is-system-running --wait) ||
		[ "$state" = degraded ]
done
