# SPDX-License-Identifier: copyleft-next-0.3.1
#
# PCIe passthrough behind an emulated IOMMU, UEFI firmware from OVMF.
# The host must bind the device to vfio-pci first (driver_override via
# udev, or vfio-pci.ids= on the kernel command line); the generator
# only grants the service the VFIO device nodes and lifts the memlock
# limit, which pinning guest memory needs.

[Unit]
Description=GPU Passthrough Guest

[QEMU]
machine=q35
nodefaults=
accel=kvm,kernel-irqchip=split
cpu=host
m=8G
smp=8
device=intel-iommu,intremap=on,caching-mode=on
drive=if=pflash,format=raw,readonly=on,file=/usr/share/OVMF/OVMF_CODE_4M.fd
drive=if=pflash,format=raw,file=ovmf-vars.fd
drive=file=root.qcow2,if=virtio,format=qcow2
device=vfio-pci,host=0000:01:00.0
netdev=user,id=net0
device=virtio-net-pci-non-transitional,netdev=net0,romfile=
device=virtio-rng-pci-non-transitional
nographic=
serial=mon:stdio
