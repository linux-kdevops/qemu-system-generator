#!/usr/bin/env bash
# SPDX-License-Identifier: copyleft-next-0.3.1
# The commit-msg hook: refuse a commit whose trailers or prose fail the check
# in scripts/check-style.sh, before the commit exists. The check needs only
# git, awk, sed, grep and python3. Link it once, by hand, into this
# repository's hooks (under a global core.hooksPath the link would serve
# every repository):
#   ln --symbolic --relative "$(git rev-parse --show-toplevel)/scripts/commit-msg" \
#       "$(git rev-parse --git-path hooks)/commit-msg"
top="$(git rev-parse --show-toplevel)"
script="$top/scripts/check-style.sh"
if ! grep --quiet -- '--commit-msg' "$script"; then
	echo "commit-msg: $script has no --commit-msg mode; commit with --no-verify" >&2
	exit 1
fi
# b4 prep keeps its cover letter in an empty commit marked by this line; it
# is never sent as a patch.
if grep --quiet --line-regexp -- '--- b4-submit-tracking ---' "$1"; then
	exit 0
fi
exec bash "$script" --commit-msg "$1"
