# SPDX-License-Identifier: copyleft-next-0.3.1
#
# inotify does not report from inside a subdirectory, so the generator
# adds a PathChanged= per drop-in directory.

[Unit]
Description=QEMU System Unit Generator Directory Watch
Documentation=man:qemu-system-generator(8)

[Path]
PathChanged=%E/qemu/systemd
MakeDirectory=yes

[Install]
WantedBy=default.target
