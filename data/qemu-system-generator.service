#
# Runs the generator for a user manager that has none installed under
# /etc/systemd/user-generators/, which only root can write to.

[Unit]
Description=QEMU System Unit Generator
Documentation=man:qemu-system-generator(8)
# The path unit starts this on every write to the directory, and a burst
# of writes must not leave the units stale.
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStartPre=mkdir --parents %t/systemd/user
# The generator never removes what it wrote for a file that is gone.
ExecStartPre=find %t/systemd/user -maxdepth 1 -type f -exec grep --quiet --fixed-strings --line-regexp "# Automatically generated by qemu-system-generator" {} \; -delete
ExecStartPre=find %t/systemd/user -mindepth 2 -maxdepth 2 -path "*.wants/*" -xtype l -delete
ExecStart=qemu-system-generator --user %t/systemd/user
# Not a second ExecStart=: the generator exits 1 when one file fails but
# still writes the others, and their units must load all the same.
ExecStopPost=systemctl --user daemon-reload

[Install]
WantedBy=default.target
