#!/bin/sh
# SPDX-License-Identifier: copyleft-next-0.3.1
#
# Generate the examples into a scratch directory and load them in a
# service manager with systemd-analyze verify, both scopes.
set -o errexit -o nounset
cd "$(dirname "$0")/.."
cargo build --quiet
tmp="$(mktemp --directory)"
trap 'rm --recursive --force "$tmp"' EXIT
for scope in system user; do
	mkdir --parents "$tmp/$scope"
	QEMU_SYSTEM_GENERATOR_UNIT_DIRS="$PWD/examples" ./target/debug/qemu-system-generator "--$scope" "$tmp/$scope"
	SYSTEMD_UNIT_PATH="$tmp/$scope:" systemd-analyze "--$scope" verify "$tmp/$scope"/*.service "$tmp/$scope"/*.socket
	echo "$scope: $(ls "$tmp/$scope" | wc --lines) entries verified"
done
