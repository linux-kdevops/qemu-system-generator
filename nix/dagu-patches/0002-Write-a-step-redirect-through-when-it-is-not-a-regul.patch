From dbaa69bcbb4512984f34eff0029199cdd2509c22 Mon Sep 17 00:00:00 2001
From: Daniel Gomez <da.gomez@kernel.org>
Date: Tue, 20 Oct 2026 22:37:03 +0200
Subject: [PATCH] Write a step redirect through when it is not a regular file

A step with stdout sent to /dev/stdout prints in bursts on a terminal:
the redirect sits behind a 4 KiB bufio.Writer that is flushed only when
full or by the 500 ms flusher. Flush each write when the redirect is not
a regular file. Dropping the buffer instead would leave a masking writer
without FlushIfDue, and the flusher would then write out a partial line
before its secret was masked.

Signed-off-by: Daniel Gomez <da.gomez@kernel.org>
---
 internal/runtime/output.go      | 19 ++++++---
 internal/runtime/output_test.go | 75 +++++++++++++++++++++++++++++++++
 internal/runtime/writer.go      | 14 ++++--
 internal/runtime/writer_test.go |  2 +-
 4 files changed, 101 insertions(+), 9 deletions(-)

diff --git a/internal/runtime/output.go b/internal/runtime/output.go
index bbb9ded28..a35b9fb8c 100644
--- a/internal/runtime/output.go
+++ b/internal/runtime/output.go
@@ -330,12 +330,19 @@ func (oc *OutputCoordinator) closeResources() error {
 // syncRegularFile syncs f when it is a regular file. A pipe, terminal or
 // device such as /dev/null has nothing to persist, and fsync on it fails.
 func syncRegularFile(f *os.File) error {
-	if info, err := f.Stat(); err == nil && !info.Mode().IsRegular() {
+	if !isRegularFile(f) {
 		return nil
 	}
 	return f.Sync()
 }
 
+// isRegularFile reports whether f is a regular file, taking a file it cannot
+// stat as one.
+func isRegularFile(f *os.File) bool {
+	info, err := f.Stat()
+	return err != nil || info.Mode().IsRegular()
+}
+
 func (oc *OutputCoordinator) setupStdoutRedirect(ctx context.Context, data NodeData) error {
 	oc.mu.Lock()
 	defer oc.mu.Unlock()
@@ -375,13 +382,15 @@ func (oc *OutputCoordinator) setupStderrRedirect(ctx context.Context, data NodeD
 }
 
 // newRedirectWriter returns a buffered writer for a redirect file, masking
-// secrets when a masker is available.
+// secrets when a masker is available. A redirect that is not a regular file
+// is written through, so a terminal or a pipe gets each line as the step
+// writes it.
 func (oc *OutputCoordinator) newRedirectWriter(file *os.File) io.Writer {
 	var writer io.Writer = file
 	if oc.masker != nil {
 		writer = masking.NewMaskingWriter(file, oc.masker)
 	}
-	return newSafeBufferedWriter(writer)
+	return newSafeBufferedWriter(writer, !isRegularFile(file))
 }
 
 // resetArtifactRedirects empties artifact redirects so that an artifact holds
@@ -487,7 +496,7 @@ func (oc *OutputCoordinator) setupLocalWriters(_ context.Context, data NodeData)
 	if oc.masker != nil {
 		stdoutWriter = masking.NewMaskingWriter(oc.stdoutFile, oc.masker)
 	}
-	oc.stdoutWriter = newSafeBufferedWriter(stdoutWriter)
+	oc.stdoutWriter = newSafeBufferedWriter(stdoutWriter, false)
 	oc.stdoutFileName = data.State.Stdout
 
 	// stderr - if merged, reuse the same file and writer
@@ -507,7 +516,7 @@ func (oc *OutputCoordinator) setupLocalWriters(_ context.Context, data NodeData)
 		if oc.masker != nil {
 			stderrWriter = masking.NewMaskingWriter(oc.stderrFile, oc.masker)
 		}
-		oc.stderrWriter = newSafeBufferedWriter(stderrWriter)
+		oc.stderrWriter = newSafeBufferedWriter(stderrWriter, false)
 		oc.stderrFileName = data.State.Stderr
 	}
 
