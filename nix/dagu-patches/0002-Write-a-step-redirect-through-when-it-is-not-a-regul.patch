 	"github.com/dagucloud/dagu/v2/internal/executor/registry"
 	"github.com/dagucloud/dagu/v2/internal/runctx"
 
@@ -555,6 +557,79 @@ func TestOutputCoordinator_CloseResources(t *testing.T) {
 	})
