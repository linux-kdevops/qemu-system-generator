+func TestOutputCoordinator_RedirectWriter(t *testing.T) {
+	t.Parallel()
+
+	t.Run("PipeGetsEachWrite", func(t *testing.T) {
+		t.Parallel()
+
+		reader, writer, err := os.Pipe()
+		require.NoError(t, err)
+		t.Cleanup(func() { _ = reader.Close(); _ = writer.Close() })
+		w := (&OutputCoordinator{}).newRedirectWriter(writer)
+
+		_, err = w.Write([]byte("line\n"))
+		require.NoError(t, err)
+
+		require.NoError(t, reader.SetReadDeadline(time.Now().Add(time.Second)))
+		buf := make([]byte, 16)
+		n, err := reader.Read(buf)
+		require.NoError(t, err)
+		assert.Equal(t, "line\n", string(buf[:n]))
+	})
+
+	t.Run("RegularFileBuffers", func(t *testing.T) {
+		t.Parallel()
+
+		file, err := os.Create(filepath.Join(t.TempDir(), "out"))
+		require.NoError(t, err)
+		t.Cleanup(func() { _ = file.Close() })
+		w := (&OutputCoordinator{}).newRedirectWriter(file)
+
+		_, err = w.Write([]byte("line\n"))
+		require.NoError(t, err)
+
+		data, err := os.ReadFile(file.Name())
+		require.NoError(t, err)
+		assert.Empty(t, data)
+
+		require.NoError(t, w.(*safeBufferedWriter).Flush())
+		data, err = os.ReadFile(file.Name())
+		require.NoError(t, err)
+		assert.Equal(t, "line\n", string(data))
+	})
+
+	t.Run("PipeMasksEachLine", func(t *testing.T) {
+		t.Parallel()
+
+		reader, writer, err := os.Pipe()
+		require.NoError(t, err)
+		t.Cleanup(func() { _ = reader.Close(); _ = writer.Close() })
+		masker := masking.NewMasker(masking.SourcedEnvVars{Secrets: []string{"TOKEN=s3cr3t"}})
+		w := (&OutputCoordinator{masker: masker}).newRedirectWriter(writer).(*safeBufferedWriter)
+		read := func() string {
+			require.NoError(t, reader.SetReadDeadline(time.Now().Add(100*time.Millisecond)))
+			buf := make([]byte, 64)
+			n, _ := reader.Read(buf)
+			return string(buf[:n])
+		}
+
+		_, err = w.Write([]byte("x s3cr3t\n"))
+		require.NoError(t, err)
+		assert.Equal(t, "x *******\n", read())
+
+		_, err = w.Write([]byte("s3c"))
+		require.NoError(t, err)
+		require.NoError(t, w.FlushIfDue())
+		assert.Empty(t, read())
+
+		_, err = w.Write([]byte("r3t"))
+		require.NoError(t, err)
+		require.NoError(t, w.Flush())
+		assert.Equal(t, "*******", read())
+	})
+}
+
 func TestCaptureRetryAfterLimit(t *testing.T) {
 	t.Parallel()
 	for _, source := range []string{"stdout", "stderr"} {
diff --git a/internal/runtime/writer.go b/internal/runtime/writer.go
index f6edffa74..cfd4f577e 100644
--- a/internal/runtime/writer.go
+++ b/internal/runtime/writer.go
@@ -63,17 +63,25 @@ type safeBufferedWriter struct {
 	mu sync.Mutex
 	w  io.Writer
 	bw *bufio.Writer
+	// writeThrough flushes every write, for a reader that follows the
+	// output as it comes, such as a terminal or a pipe. A masking writer
+	// below still holds a partial line until its newline arrives.
+	writeThrough bool
 }
 
 // newSafeBufferedWriter creates a thread-safe buffered writer
-func newSafeBufferedWriter(w io.Writer) *safeBufferedWriter {
-	return &safeBufferedWriter{w: w, bw: bufio.NewWriter(w)}
+func newSafeBufferedWriter(w io.Writer, writeThrough bool) *safeBufferedWriter {
+	return &safeBufferedWriter{w: w, bw: bufio.NewWriter(w), writeThrough: writeThrough}
 }
 
 func (s *safeBufferedWriter) Write(p []byte) (int, error) {
 	s.mu.Lock()
 	defer s.mu.Unlock()
-	return s.bw.Write(p)
+	n, err := s.bw.Write(p)
+	if err == nil && s.writeThrough {
+		err = s.bw.Flush()
+	}
+	return n, err
 }
 
 // FlushIfDue writes buffered output through. A partial line the wrapped
diff --git a/internal/runtime/writer_test.go b/internal/runtime/writer_test.go
index 4b7f8d7e9..d996bd420 100644
--- a/internal/runtime/writer_test.go
+++ b/internal/runtime/writer_test.go
@@ -251,7 +251,7 @@ func TestFlushableMultiWriter_Integration(t *testing.T) {
 func TestSafeBufferedWriter_MaskedPartialLine(t *testing.T) {
 	var out bytes.Buffer
 	masker := masking.NewMasker(masking.SourcedEnvVars{Secrets: []string{"TOKEN=s3cr3t"}})
-	w := newSafeBufferedWriter(masking.NewMaskingWriter(&out, masker))
+	w := newSafeBufferedWriter(masking.NewMaskingWriter(&out, masker), false)
 
 	_, err := w.Write([]byte("s3c"))
 	require.NoError(t, err)
