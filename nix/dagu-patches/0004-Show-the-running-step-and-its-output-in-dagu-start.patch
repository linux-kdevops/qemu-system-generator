+
+// syncBuffer is a bytes.Buffer safe to read while the display writes to it.
+type syncBuffer struct {
+	mu  sync.Mutex
+	buf bytes.Buffer
+}
+
+func (b *syncBuffer) Write(p []byte) (int, error) {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	return b.buf.Write(p)
+}
+
+func (b *syncBuffer) String() string {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	return b.buf.String()
+}
+
+func newTestRegion(t *testing.T, names ...string) (*RegionProgressDisplay, *syncBuffer) {
+	t.Helper()
+	dag := &ir.DAG{Name: "test"}
+	for _, name := range names {
+		dag.Steps = append(dag.Steps, ir.Step{Name: name})
+	}
+	p := NewRegionProgressDisplay(dag)
+	out := &syncBuffer{}
+	p.out = out
+	p.tty = false
+	p.keys = false
+	p.profile = colorprofile.Ascii
+	p.size = func() (int, int) { return 50, 20 }
+	p.startTime = time.Now()
+	return p, out
+}
+
+func frame(p *RegionProgressDisplay, cols, rows int) []string {
+	now := time.Now()
+	return p.region(p.state(now), now, cols, rows)
+}
+
+func write(t *testing.T, p *RegionProgressDisplay, step, text string) {
+	t.Helper()
+	_, err := p.StepOutput(step).Write([]byte(text))
+	require.NoError(t, err)
+}
+
+func TestRegionProgressDisplay_Region(t *testing.T) {
+	t.Parallel()
+
+	p, _ := newTestRegion(t, "configure", "build", "boot")
+	p.UpdateNode(&ir.Node{Step: ir.Step{Name: "configure"}, Status: ir.NodeSucceeded})
+	p.UpdateNode(&ir.Node{Step: ir.Step{Name: "build"}, Status: ir.NodeRunning, Stdout: "/logs/build.out"})
+	write(t, p, "build", "  CC init/main.o\n  CC\tkernel/fork.o\n  LD vmli")
+
+	p.SetDAGRunInfo("034jOFuV", "src=/linux")
+	lines := frame(p, 50, 20)
+	require.Len(t, lines, regionFixedRows+regionWindowLines+1)
+	assert.True(t, strings.HasPrefix(lines[0], "test  034jOFuV  src=/linux "), lines[0])
+	assert.Equal(t, strings.Repeat("━", 30)+strings.Repeat("─", 15)+" 1/3", lines[1])
+	assert.Contains(t, lines[2], "[RUNNING] build ")
+	assert.True(t, strings.HasPrefix(lines[3], "╭─ output ─"), lines[3])
+	assert.Equal(t, "│   CC init/main.o", strings.TrimRight(lines[4], " │"))
+	assert.Equal(t, "│   CC    kernel/fork.o", strings.TrimRight(lines[5], " │"))
+	assert.Equal(t, "│   LD vmli", strings.TrimRight(lines[6], " │"))
+	assert.Equal(t, "╰"+strings.Repeat("─", 47)+"╯", lines[len(lines)-2])
+	assert.Equal(t, " log /logs/build.out", lines[len(lines)-1])
+	for _, line := range lines[:len(lines)-1] {
+		assert.Equal(t, 49, lipgloss.Width(line), line)
+	}
+}
