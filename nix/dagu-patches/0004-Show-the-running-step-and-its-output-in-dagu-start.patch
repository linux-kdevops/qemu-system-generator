+func TestRegionProgressDisplay_SubRuns(t *testing.T) {
+	t.Parallel()
+
+	p, _ := newTestRegion(t, "boot", "sections")
+	p.UpdateNode(&ir.Node{Step: ir.Step{Name: "boot"}, Status: ir.NodeSucceeded})
+	p.UpdateNode(&ir.Node{Step: ir.Step{Name: "sections"}, Status: ir.NodeRunning, SubRuns: []ir.SubDAGRun{
+		{DAGRunID: "child-1", ParallelItem: `"xfs_bs4k_ss4k"`, DAGName: "section"},
+	}})
+	child := p.SubRunProgress("child-1")
+	child.UpdateNode(&ir.Node{Step: ir.Step{Name: "start"}, Status: ir.NodeRunning})
+	_, err := child.(interface{ StepOutput(string) io.Writer }).StepOutput("start").Write([]byte("generic/001 3s\n"))
+	require.NoError(t, err)
+
+	lines := frame(p, 60, 20)
+	assert.True(t, strings.HasSuffix(lines[1], " 1/2"), lines[1])
+	assert.Contains(t, lines[2], "[RUNNING] sections › xfs_bs4k_ss4k › start")
+	assert.NotContains(t, lines[2], "2/2")
+	assert.Equal(t, "│ generic/001 3s", strings.TrimRight(lines[4], " │"))
+
+	// A sub-DAG run of the sub-DAG run nests one level further.
+	child.UpdateNode(&ir.Node{Step: ir.Step{Name: "start"}, Status: ir.NodeRunning, SubRuns: []ir.SubDAGRun{
+		{DAGRunID: "grandchild-1", DAGName: "check"},
+	}})
+	grandchild := child.(subRunReporter).SubRunProgress("grandchild-1")
+	grandchild.UpdateNode(&ir.Node{Step: ir.Step{Name: "collect"}, Status: ir.NodeRunning})
+	assert.Contains(t, frame(p, 80, 20)[2], "sections › xfs_bs4k_ss4k › start › collect")
+
+	// When the sub-DAG's step ends, the focus stays on it.
+	grandchild.UpdateNode(&ir.Node{Step: ir.Step{Name: "collect"}, Status: ir.NodeSucceeded})
+	assert.Contains(t, frame(p, 80, 20)[2], "› start")
+}
