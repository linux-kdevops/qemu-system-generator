diff --git a/internal/runtime/agent/progress_keys_unix.go b/internal/runtime/agent/progress_keys_unix.go
new file mode 100644
index 000000000..b0eaad5fd
--- /dev/null
+++ b/internal/runtime/agent/progress_keys_unix.go
@@ -0,0 +1,89 @@
+// Copyright (C) 2026 Yota Hamada
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+//go:build linux || darwin || dragonfly || freebsd || netbsd || openbsd
+
+package agent
+
+import (
+	"errors"
+	"os"
+	"os/signal"
+	"syscall"
+
+	"golang.org/x/sys/unix"
+)
+
+// readKeys passes each key pressed on the terminal at stdin to key, until
+// the returned function stops reading and puts the terminal back as it was.
+// The terminal stops waiting for a whole line and echoing it, but keeps its
+// signals, so Ctrl-C still interrupts the run; keys other than the ones key
+// acts on are dropped while it reads. It does nothing when stdin is not a
+// terminal or the run is not its foreground job, where changing the mode
+// would stop the process with SIGTTOU.
+func readKeys(key func(byte)) (restore func()) {
+	fd := int(os.Stdin.Fd())
+	if pgrp, err := unix.IoctlGetInt(fd, unix.TIOCGPGRP); err != nil || pgrp != unix.Getpgrp() {
+		return func() {}
+	}
+	old, err := unix.IoctlGetTermios(fd, ioctlGetTermios)
+	if err != nil {
+		return func() {}
+	}
+	stop, wake, err := os.Pipe()
+	if err != nil {
+		return func() {}
+	}
+	keys := *old
+	keys.Lflag &^= unix.ICANON | unix.ECHO
+	keys.Cc[unix.VMIN] = 1
+	keys.Cc[unix.VTIME] = 0
+	if err := unix.IoctlSetTermios(fd, ioctlSetTermios, &keys); err != nil {
+		_ = stop.Close()
+		_ = wake.Close()
+		return func() {}
+	}
+
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		stopFd := int(stop.Fd())
+		buf := make([]byte, 16)
+		for {
+			// select rather than poll: macOS poll does not take a terminal.
+			var set unix.FdSet
+			set.Set(fd)
+			set.Set(stopFd)
+			if _, err := unix.Select(max(fd, stopFd)+1, &set, nil, nil, nil); err != nil {
+				if errors.Is(err, unix.EINTR) {
+					continue
+				}
+				return
+			}
+			if set.IsSet(stopFd) {
+				return
+			}
+			n, err := unix.Read(fd, buf)
+			if errors.Is(err, unix.EINTR) || errors.Is(err, unix.EAGAIN) {
+				continue
+			}
+			if err != nil || n == 0 {
+				return
+			}
+			for _, b := range buf[:n] {
+				key(b)
+			}
+		}
+	}()
+
+	return func() {
+		_ = wake.Close()
+		<-done
+		_ = stop.Close()
+		// Moved to the background since, the process would stop on the
+		// restore; ignoring SIGTTOU lets it through.
+		signal.Ignore(syscall.SIGTTOU)
+		_ = unix.IoctlSetTermios(fd, ioctlSetTermios, old)
+		signal.Reset(syscall.SIGTTOU)
+	}
+}
diff --git a/internal/runtime/agent/progress_region.go b/internal/runtime/agent/progress_region.go
new file mode 100644
index 000000000..c2bf23977
--- /dev/null
+++ b/internal/runtime/agent/progress_region.go
@@ -0,0 +1,836 @@
+// Copyright (C) 2026 Yota Hamada
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+package agent
+
+import (
+	"bytes"
+	"fmt"
+	"image/color"
+	"io"
+	"os"
+	"slices"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"charm.land/lipgloss/v2"
+	"github.com/charmbracelet/colorprofile"
+	"github.com/dagucloud/dagu/v2/internal/cmn/stringutil"
+	"github.com/dagucloud/dagu/v2/internal/ir"
+	"github.com/mattn/go-runewidth"
+	"golang.org/x/term"
+)
+
+const (
+	// regionWindowLines is how many lines of the focused step's output the
+	// region shows.
+	regionWindowLines = 10
+	// regionFixedRows counts the region's rows besides the output lines and
+	// the log path: the header, the bar, the step and the pane's two borders.
+	regionFixedRows = 5
+	// regionMarginRows keeps the region off the terminal's top row and leaves
+	// the row the cursor rests on below it.
+	regionMarginRows = 2
+	// regionKeptLines is how many lines of each step's output are kept, and
+	// regionLineBytes how much of each line.
+	regionKeptLines = 200
+	regionLineBytes = 4096
+	// regionFrame is the shortest time between two frames.
+	regionFrame = 16 * time.Millisecond
+	// regionTick redraws a quiet region, for the clock and the spinner.
+	regionTick = 100 * time.Millisecond
+)
+
+// RegionProgressDisplay keeps a fixed region at the bottom of the terminal
+// and redraws it in place: a bar with a segment per step, the running step
+// with its status and elapsed time, and a pane with the step's last lines of
+// output. The output comes from the runner as the step writes it, through
+// StepOutput, so a step needs no redirect to reach the terminal and never
+// interleaves with the region.
+type RegionProgressDisplay struct {
+	progressWriter
+
+	dag      *ir.DAG
+	dagRunID string
+	params   string
+	profile  colorprofile.Profile
+
+	mu sync.Mutex
+	// steps are the DAG's steps in order: the bar's segments and the counts.
+	steps []string
+	// nodes holds every step seen, the DAG's own under their name and those
+	// of a sub-DAG run under subRunKey.
+	nodes map[string]*regionNode
+	// subRuns maps a sub-DAG run to the step that started it.
+	subRuns   map[string]regionSubRun
+	focus     string
+	status    ir.Status
+	startTime time.Time
+
+	// changed wakes the drawing goroutine when output or a status arrives.
+	changed chan struct{}
+
+	// keys is whether the region reads keys from the terminal, and
+	// maximized whether the pane fills the terminal instead of
+	// regionWindowLines rows; w switches between the two.
+	keys        bool
+	maximized   atomic.Bool
+	restoreKeys func()
+	restoreOnce sync.Once
+
+	// Owned by the drawing goroutine.
+	drawn     []int
+	drawnCols int
+	drawnRows int
+	spinner   int
+	size      func() (cols, rows int)
+
+	stopOnce sync.Once
+	stopCh   chan struct{}
+	done     chan struct{}
+}
+
+type regionNode struct {
+	name     string
+	runID    string
+	status   ir.NodeStatus
+	started  time.Time
+	finished time.Time
+	log      string
+	lines    []string
+	partial  string
+}
+
+// regionState is what one frame shows, copied under the lock so that
+// writing the terminal never holds up the runner or a step's output.
+type regionState struct {
+	statuses []ir.NodeStatus
+	focus    string
+	label    string
+	node     regionNode
+	status   ir.Status
+	elapsed  time.Duration
+}
+
+// NewRegionProgressDisplay creates a region display for dag.
+func NewRegionProgressDisplay(dag *ir.DAG) *RegionProgressDisplay {
+	p := &RegionProgressDisplay{
+		progressWriter: newProgressWriter(),
+		dag:            dag,
+		profile:        colorprofile.Detect(os.Stderr, os.Environ()),
+		nodes:          make(map[string]*regionNode),
+		subRuns:        make(map[string]regionSubRun),
+		changed:        make(chan struct{}, 1),
+		keys:           term.IsTerminal(int(os.Stdin.Fd())) && term.IsTerminal(int(os.Stderr.Fd())),
+		size:           stderrSize,
+		stopCh:         make(chan struct{}),
+		done:           make(chan struct{}),
+	}
+	if dag != nil {
+		for _, step := range dag.Steps {
+			p.steps = append(p.steps, step.Name)
+			p.nodes[step.Name] = &regionNode{name: step.Name}
+		}
+	}
+	return p
+}
+
+// redirectsToTerminal reports whether a step of dag writes to the terminal
+// itself, which would scroll through a region drawn there.
+func redirectsToTerminal(dag *ir.DAG) bool {
+	if dag == nil {
+		return false
+	}
+	for _, step := range dag.Steps {
+		for _, path := range []string{step.Stdout, step.Stderr} {
+			switch path {
+			case "/dev/stdout", "/dev/stderr", "/dev/tty", "/dev/fd/1", "/dev/fd/2":
+				return true
+			}
+		}
+	}
+	return false
+}
+
+func stderrSize() (int, int) {
+	cols, rows, err := term.GetSize(int(os.Stderr.Fd()))
+	if err != nil {
+		return 100, 40
+	}
+	return cols, rows
+}
+
+// Start begins the progress display.
+func (p *RegionProgressDisplay) Start() {
+	p.restoreKeys = func() {}
+	if p.keys {
+		p.restoreKeys = readKeys(p.key)
+	}
+	go p.run()
+}
+
+// Stop stops the progress display and gives the terminal its mode back.
+// Safe to call multiple times.
+func (p *RegionProgressDisplay) Stop() {
+	p.stopOnce.Do(func() {
+		close(p.stopCh)
+	})
+	<-p.done
+	p.restoreOnce.Do(func() {
+		if p.restoreKeys != nil {
+			p.restoreKeys()
+		}
+	})
+}
+
+// key acts on a key pressed while the region is shown.
+func (p *RegionProgressDisplay) key(b byte) {
+	if b == 'w' || b == 'W' {
+		p.maximized.Store(!p.maximized.Load())
+		p.wake()
+	}
+}
+
+// StepOutput returns a writer for the output of the named step. Each call
+// returns its own writer, so stdout and stderr keep their own partial line.
+func (p *RegionProgressDisplay) StepOutput(stepName string) io.Writer {
+	return &regionOutput{p: p, key: stepName, name: stepName}
+}
+
+// regionOutput splits a step's output into lines for the region.
+type regionOutput struct {
+	p       *RegionProgressDisplay
+	key     string
+	runID   string
+	name    string
+	partial []byte
+}
+
+func (w *regionOutput) Write(b []byte) (int, error) {
+	w.partial = append(w.partial, b...)
+	var complete []string
+	for {
+		i := bytes.IndexByte(w.partial, '\n')
+		if i < 0 {
+			break
+		}
+		complete = append(complete, cleanLine(string(w.partial[:min(i, regionLineBytes)])))
+		w.partial = w.partial[i+1:]
+	}
+	if len(w.partial) > regionLineBytes {
+		complete = append(complete, cleanLine(string(w.partial)))
+		w.partial = w.partial[:0]
+	}
+
+	p := w.p
+	p.mu.Lock()
+	n := p.node(w.key, w.runID, w.name)
+	n.lines = append(n.lines, complete...)
+	if extra := len(n.lines) - regionKeptLines; extra > 0 {
+		n.lines = slices.Delete(n.lines, 0, extra)
+	}
+	n.partial = cleanLine(string(w.partial))
+	p.mu.Unlock()
+	p.wake()
+	return len(b), nil
+}
+
+func (p *RegionProgressDisplay) wake() {
+	select {
+	case p.changed <- struct{}{}:
+	default:
+	}
+}
+
+// node returns the record of the step under key, adding one for a handler
+// such as onExit or a sub-DAG's step, which are shown while they run but are
+// not among the bar's steps.
+func (p *RegionProgressDisplay) node(key, runID, name string) *regionNode {
+	n, ok := p.nodes[key]
+	if !ok {
+		n = &regionNode{name: name, runID: runID}
+		p.nodes[key] = n
+	}
+	return n
+}
+
+// regionSubRun is a sub-DAG run: the step that started it and, for a
+// parallel step, the item it runs.
+type regionSubRun struct {
+	parent string
+	item   string
+	dag    string
+}
+
+// subRunKey is the key of a sub-DAG run's step in nodes.
+func subRunKey(runID, stepName string) string {
+	return runID + "\x00" + stepName
+}
+
+// SubRunProgress returns the reporter of a sub-DAG run started by a step
+// of this run or of one of its sub-DAG runs, which runs in this process and
+// shows its steps and their output in this region.
+func (p *RegionProgressDisplay) SubRunProgress(dagRunID string) ProgressReporter {
+	return &regionSubRunReporter{p: p, runID: dagRunID}
+}
+
+// UpdateNode records a step's status, times and log file.
+func (p *RegionProgressDisplay) UpdateNode(node *ir.Node) {
+	p.update(node.Step.Name, "", node)
+}
+
+func (p *RegionProgressDisplay) update(key, runID string, node *ir.Node) {
+	p.mu.Lock()
+	n := p.node(key, runID, node.Step.Name)
+	for _, sub := range node.SubRuns {
+		p.subRuns[sub.DAGRunID] = regionSubRun{
+			parent: key,
+			item:   strings.Trim(sub.ParallelItem, `"`),
+			dag:    sub.DAGName,
+		}
+	}
+	now := time.Now()
+	if isRunning(node.Status) && !isRunning(n.status) {
+		// A first start, a retry or the next round of a repeat.
+		n.started = now
+		n.finished = time.Time{}
+		p.focus = key
+		p.dropFinishedOutput(key)
+	}
+	if node.Status.IsDone() && !n.status.IsDone() {
+		n.finished = parseTimeOr(node.FinishedAt, now)
+		if n.started.IsZero() {
+			n.started = parseTimeOr(node.StartedAt, n.finished)
+		}
+	}
+	n.status = node.Status
+	if node.Stdout != "" {
+		n.log = node.Stdout
+	}
+	p.mu.Unlock()
+	p.wake()
+}
+
+// dropFinishedOutput forgets the output of the sub-DAG runs' steps that
+// succeeded, other than keep, so a run with hundreds of sub-DAG runs holds
+// the output of the few it can still show.
+func (p *RegionProgressDisplay) dropFinishedOutput(keep string) {
+	for key, n := range p.nodes {
+		if key != keep && n.runID != "" && n.status.IsSuccess() && n.lines != nil {
+			n.lines, n.partial = nil, ""
+		}
+	}
+}
+
+// regionSubRunReporter passes a sub-DAG run's steps and output to the
+// region of the run that started it; the region is that run's to start and
+// stop.
+type regionSubRunReporter struct {
+	p     *RegionProgressDisplay
+	runID string
+}
+
+func (c *regionSubRunReporter) Start()                        {}
+func (c *regionSubRunReporter) Stop()                         {}
+func (c *regionSubRunReporter) UpdateStatus(*ir.DAGRunStatus) {}
+func (c *regionSubRunReporter) SetDAGRunInfo(string, string)  {}
+
+func (c *regionSubRunReporter) UpdateNode(node *ir.Node) {
+	c.p.update(subRunKey(c.runID, node.Step.Name), c.runID, node)
+}
+
+// StepOutput returns a writer for the output of the sub-DAG run's step.
+func (c *regionSubRunReporter) StepOutput(stepName string) io.Writer {
+	return &regionOutput{p: c.p, key: subRunKey(c.runID, stepName), runID: c.runID, name: stepName}
+}
+
+// SubRunProgress returns the reporter of a sub-DAG run this one starts.
+func (c *regionSubRunReporter) SubRunProgress(dagRunID string) ProgressReporter {
+	return c.p.SubRunProgress(dagRunID)
+}
+
+// label names the step under key by its path from the run's own steps,
+// such as sections › xfs_bs4k_ss4k › start.
+func (p *RegionProgressDisplay) label(key string) string {
+	var parts []string
+	for range 16 {
+		n, ok := p.nodes[key]
+		if !ok {
+			break
+		}
+		parts = append(parts, printable(stringutil.StripANSI(n.name)))
+		if n.runID == "" {
+			break
+		}
+		sub, ok := p.subRuns[n.runID]
+		if !ok {
+			break
+		}
+		if sub.item != "" {
+			parts = append(parts, printable(stringutil.StripANSI(sub.item)))
+		}
+		key = sub.parent
+	}
+	slices.Reverse(parts)
+	return strings.Join(parts, " › ")
+}
+
+func isRunning(s ir.NodeStatus) bool {
+	return s == ir.NodeRunning || s == ir.NodeRetrying
+}
+
+func parseTimeOr(value string, fallback time.Time) time.Time {
+	if t, err := stringutil.ParseTime(value); err == nil && !t.IsZero() {
+		return t
+	}
+	return fallback
+}
+
+// UpdateStatus updates the overall DAG status.
+func (p *RegionProgressDisplay) UpdateStatus(status *ir.DAGRunStatus) {
+	p.mu.Lock()
+	p.status = status.Status
+	p.mu.Unlock()
+	p.wake()
+}
+
+// SetDAGRunInfo sets the DAG run ID and parameters.
+func (p *RegionProgressDisplay) SetDAGRunInfo(dagRunID, params string) {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	p.dagRunID = dagRunID
+	p.params = params
+}
+
+// run draws a frame when something changed, at most one per regionFrame,
+// and otherwise every regionTick.
+func (p *RegionProgressDisplay) run() {
+	defer close(p.done)
+
+	p.mu.Lock()
+	p.startTime = time.Now()
+	p.mu.Unlock()
+
+	tick := time.NewTicker(regionTick)
+	defer tick.Stop()
+	var last time.Time
+	for {
+		select {
+		case <-p.stopCh:
+			p.printFinal()
+			return
+		case <-tick.C:
+			p.spinner++
+		case <-p.changed:
+			if wait := regionFrame - time.Since(last); wait > 0 {
+				select {
+				case <-p.stopCh:
+					p.printFinal()
+					return
+				case <-time.After(wait):
+				}
+			}
+		}
+		p.redraw()
+		last = time.Now()
+	}
+}
+
+// state copies what a frame shows. The focus stays on the step that started
+// last while it runs, which is the deepest one when a sub-DAG runs, then
+// moves to the running step that started last, and otherwise stays on the
+// last step that ran.
+func (p *RegionProgressDisplay) state(now time.Time) regionState {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+
+	s := regionState{status: p.status, elapsed: now.Sub(p.startTime)}
+	for _, name := range p.steps {
+		s.statuses = append(s.statuses, p.nodes[name].status)
+	}
+	if n, ok := p.nodes[p.focus]; !ok || !isRunning(n.status) {
+		var latest time.Time
+		for key, n := range p.nodes {
+			if isRunning(n.status) && n.started.After(latest) {
+				p.focus, latest = key, n.started
+			}
+		}
+	}
+	if n, ok := p.nodes[p.focus]; ok {
+		s.focus = p.focus
+		s.label = p.label(p.focus)
+		s.node = *n
+		s.node.lines = slices.Clone(n.lines)
+	}
+	return s
+}
+
+func (p *RegionProgressDisplay) redraw() {
+	now := time.Now()
+	s := p.state(now)
+	cols, rows := p.size()
+	p.draw(p.region(s, now, cols, rows), cols, rows)
+}
+
+// draw replaces the region on screen with lines in one write. Each line
+// overwrites the one drawn before it and erases only what is left of it, so
+// the region never shows blank between frames. After the terminal changed
+// size, the region is drawn again on a cleared screen: a terminal that
+// re-wraps its lines and one that cuts them leave the old region over a
+// different number of rows, and only a clear screen is the same on both.
+func (p *RegionProgressDisplay) draw(lines []string, cols, rows int) {
+	var buf strings.Builder
+	if len(p.drawn) > 0 && (cols != p.drawnCols || rows != p.drawnRows) {
+		buf.WriteString("\x1b[0m\x1b[H\x1b[2J")
+		p.drawn = p.drawn[:0]
+	}
+	p.drawnCols, p.drawnRows = cols, rows
+	buf.WriteString(p.home(cols, rows))
+	for _, line := range lines {
+		buf.WriteString(line)
+		buf.WriteString("\x1b[K\n")
+	}
+	buf.WriteString("\x1b[J")
+	_, _ = io.WriteString(p.out, buf.String())
+	p.drawn = p.drawn[:0]
+	for _, line := range lines {
+		p.drawn = append(p.drawn, lipgloss.Width(line))
+	}
+}
+
+// home returns the sequence that moves the cursor to the start of the
+// region's first row. A terminal that got narrower has re-wrapped the drawn
+// lines, so the rows are counted at the width now, and never past the top of
+// the screen.
+func (p *RegionProgressDisplay) home(cols, rows int) string {
+	if len(p.drawn) == 0 {
+		return ""
+	}
+	cols = max(cols, 1)
+	n := 0
+	for _, w := range p.drawn {
+		n += max(1, (w+cols-1)/cols)
+	}
+	n = min(n, max(rows-1, 1))
+	return fmt.Sprintf("\x1b[0m\r\x1b[%dA", n)
+}
+
+// region returns the frame's lines, each fitted to cols - 1 columns, and no
+// more of them than the terminal has rows to spare.
+func (p *RegionProgressDisplay) region(s regionState, now time.Time, cols, rows int) []string {
+	width := max(cols-1, 20)
+	log := p.logLines(s.node.log, width)
+	window := max(1, rows-regionFixedRows-len(log)-regionMarginRows)
+	if !p.maximized.Load() {
+		window = min(window, regionWindowLines)
+	}
+	lines := []string{p.header(s, width), p.barLine(s.statuses, width), p.stepLine(s, now, width)}
+	lines = append(lines, p.pane(s.node, window, width, p.keys)...)
+	lines = append(lines, log...)
+	if limit := max(rows-regionMarginRows, 1); len(lines) > limit {
+		lines = lines[:limit]
+	}
+	return lines
+}
+
+// header names the DAG, the run and its parameters, with the time the run
+// has taken at the right edge.
+func (p *RegionProgressDisplay) header(s regionState, width int) string {
+	p.mu.Lock()
+	name, runID, params := "unknown", p.dagRunID, p.params
+	if p.dag != nil {
+		name = p.dag.Name
+	}
+	p.mu.Unlock()
+	name, runID, params = cleanLine(name), cleanLine(runID), cleanLine(params)
+	elapsed := stringutil.FormatDuration(s.elapsed.Truncate(100 * time.Millisecond))
+	room := max(width-runewidth.StringWidth(elapsed)-1, 1)
+	name = fit(name, room)
+	rest := fit(strings.TrimRight("  "+runID+"  "+params, " "), room-runewidth.StringWidth(name))
+	gap := max(room-runewidth.StringWidth(name)-runewidth.StringWidth(rest), 0)
+	if p.profile > colorprofile.Ascii {
+		name = lipgloss.NewStyle().Bold(true).Render(name)
+	}
+	return name + p.paint(colorFaint, rest) + strings.Repeat(" ", gap+1) + p.paint(colorText, elapsed)
+}
+
+// Colors of the region, converted to what the terminal can show.
+var (
+	colorDone    = lipgloss.Color("#3FB950")
+	colorStart   = lipgloss.Color("#2DD4BF")
+	colorRun     = lipgloss.Color("#38BDF8")
+	colorFail    = lipgloss.Color("#F85149")
+	colorWait    = lipgloss.Color("#D29922")
+	colorFaint   = lipgloss.Color("#6E7681")
+	colorText    = lipgloss.Color("#E6EDF3")
+	colorPillInk = lipgloss.Color("#0D1117")
+)
+
+// paint renders text in c, or leaves it plain on a terminal without colors.
+func (p *RegionProgressDisplay) paint(c color.Color, text string) string {
+	if p.profile <= colorprofile.Ascii {
+		return text
+	}
+	return lipgloss.NewStyle().Foreground(p.profile.Convert(c)).Render(text)
+}
+
+// barLine is a full-width bar with a segment per step, colored by the
+// step's status, followed by the number of finished steps.
+func (p *RegionProgressDisplay) barLine(statuses []ir.NodeStatus, width int) string {
+	finished := 0
+	for _, s := range statuses {
+		if s.IsDone() {
+			finished++
+		}
+	}
+	count := fmt.Sprintf(" %d/%d", finished, len(statuses))
+	cells := max(width-runewidth.StringWidth(count), 1)
+	if len(statuses) == 0 {
+		return p.paint(colorFaint, strings.Repeat("─", cells)+count)
+	}
+	gradient := lipgloss.Blend1D(cells, colorStart, colorDone)
+	var b strings.Builder
+	for c := range cells {
+		lo := c * len(statuses) / cells
+		hi := max((c+1)*len(statuses)/cells, lo+1)
+		status := statuses[lo]
+		for _, r := range barRank {
+			if slices.Contains(statuses[lo:hi], r) {
+				status = r
+				break
+			}
+		}
+		switch {
+		case status == ir.NodeNotStarted:
+			b.WriteString(p.paint(colorFaint, "─"))
+		case status == ir.NodeSkipped:
+			b.WriteString(p.paint(colorFaint, "━"))
+		case status.IsSuccess():
+			b.WriteString(p.paint(gradient[c], "━"))
+		default:
+			b.WriteString(p.paint(statusColor(status), "━"))
+		}
+	}
+	return b.String() + p.paint(colorText, count)
+}
+
+// barRank orders statuses by how much they matter when steps share a cell.
+var barRank = []ir.NodeStatus{
+	ir.NodeFailed, ir.NodeAborted, ir.NodeRejected, ir.NodeRunning,
+	ir.NodeRetrying, ir.NodeWaiting, ir.NodeNotStarted, ir.NodePartiallySucceeded,
+	ir.NodeSucceeded, ir.NodeSkipped,
+}
+
+func statusColor(s ir.NodeStatus) color.Color {
+	switch {
+	case isRunning(s):
+		return colorRun
+	case s == ir.NodeWaiting:
+		return colorWait
+	case s == ir.NodeSkipped || s == ir.NodeNotStarted:
+		return colorFaint
+	case s.IsSuccess():
+		return colorDone
+	default:
+		return colorFail
+	}
+}
+
+func statusLabel(s ir.NodeStatus) string {
+	switch {
+	case isRunning(s):
+		return "RUNNING"
+	case s == ir.NodeWaiting:
+		return "WAITING"
+	case s == ir.NodeSkipped:
+		return "SKIPPED"
+	case s == ir.NodeNotStarted:
+		return "PENDING"
+	case s.IsSuccess():
+		return "DONE"
+	default:
+		return "FAILED"
+	}
+}
+
+// pill renders a status as a colored label, or in brackets without colors.
+func (p *RegionProgressDisplay) pill(s ir.NodeStatus) string {
+	label := statusLabel(s)
+	if p.profile <= colorprofile.Ascii {
+		return "[" + label + "]"
+	}
+	return lipgloss.NewStyle().Bold(true).Padding(0, 1).
+		Foreground(p.profile.Convert(colorPillInk)).
+		Background(p.profile.Convert(statusColor(s))).
+		Render(label)
+}
+
+// stepLine is the focused step: a spinner while it runs, its status, name
+// and place in the DAG, and its elapsed time at the right edge.
+func (p *RegionProgressDisplay) stepLine(s regionState, now time.Time, width int) string {
+	if s.focus == "" {
+		return p.paint(colorFaint, fit(" waiting for the first step", width))
+	}
+	n := s.node
+	mark, end := " ", now
+	if isRunning(n.status) {
+		mark = p.paint(colorRun, stringutil.SpinnerFrames[p.spinner%len(stringutil.SpinnerFrames)])
+	}
+	if n.status.IsDone() {
+		end = n.finished
+	}
+	elapsed := stringutil.FormatDuration(end.Sub(n.started).Truncate(100 * time.Millisecond))
+	left := mark + " " + p.pill(n.status) + " "
+	room := max(width-lipgloss.Width(left)-runewidth.StringWidth(elapsed)-1, 1)
+	name := fit(s.label, room)
+	gap := max(room-runewidth.StringWidth(name), 0)
+
+	if p.profile > colorprofile.Ascii {
+		name = lipgloss.NewStyle().Bold(true).Render(name)
+	}
+	return left + name + strings.Repeat(" ", gap+1) + p.paint(colorFaint, elapsed)
+}
+
+// pane boxes the last window lines of the step's output, naming the key
+// that maximizes it when keys are read.
+func (p *RegionProgressDisplay) pane(n regionNode, window, width int, keys bool) []string {
+	inner := width - 4
+	title, hint := "─ output ", ""
+	if keys {
+		hint = " w maximize ─"
+		if p.maximized.Load() {
+			hint = " w restore ─"
+		}
+	}
+	fill := max(width-2-runewidth.StringWidth(title)-runewidth.StringWidth(hint), 0)
+	lines := []string{p.paint(colorFaint, "╭"+title+strings.Repeat("─", fill)+hint+"╮")}
+	out := n.lines
+	if n.partial != "" {
+		out = append(slices.Clone(out), n.partial)
+	}
+	if len(out) > window {
+		out = out[len(out)-window:]
+	}
+	for i := range window {
+		text := ""
+		if i < len(out) {
+			text = fit(out[i], inner)
+		}
+		pad := strings.Repeat(" ", max(inner-runewidth.StringWidth(text), 0))
+		lines = append(lines, p.paint(colorFaint, "│")+" "+text+pad+" "+p.paint(colorFaint, "│"))
+	}
+	lines = append(lines, p.paint(colorFaint, "╰"+strings.Repeat("─", max(width-2, 0))+"╯"))
+	return lines
+}
+
+// logLines is the path of the step's log, whole, folded over as many lines
+// as it needs to fit width.
+func (p *RegionProgressDisplay) logLines(path string, width int) []string {
+	if path == "" {
+		return nil
+	}
+	const label, indent = " log ", "     "
+	var lines []string
+	rest := []rune(path)
+	for prefix := label; len(rest) > 0; prefix = indent {
+		room := max(width-runewidth.StringWidth(prefix), 1)
+		n, w := 0, 0
+		for n < len(rest) && w+runewidth.RuneWidth(rest[n]) <= room {
+			w += runewidth.RuneWidth(rest[n])
+			n++
+		}
+		n = max(n, 1)
+		lines = append(lines, p.paint(colorFaint, prefix)+string(rest[:n]))
+		rest = rest[n:]
+	}
+	return lines
+}
+
+// printFinal replaces the region with the final bar and a summary line. A
+// run that did not succeed keeps the focused step and its pane, which say
+// why.
+func (p *RegionProgressDisplay) printFinal() {
+	now := time.Now()
+	s := p.state(now)
+	cols, rows := p.size()
+	width := max(cols-1, 20)
+
+	finished := 0
+	for _, st := range s.statuses {
+		if st.IsDone() {
+			finished++
+		}
+	}
+	summary := fmt.Sprintf("%s %d/%d steps in %s", statusIcon(s.status), finished, len(s.statuses),
+		stringutil.FormatDuration(s.elapsed.Truncate(100*time.Millisecond)))
+	lines := []string{
+		p.header(s, width), p.barLine(s.statuses, width),
+		p.paint(statusColorOf(s.status), fit(summary, width)),
+	}
+	if !s.status.IsSuccess() && s.focus != "" {
+		lines = append(lines, p.stepLine(s, now, width))
+		lines = append(lines, p.pane(s.node, regionWindowLines, width, false)...)
+		lines = append(lines, p.logLines(s.node.log, width)...)
+	}
+	p.draw(lines, cols, rows)
+	p.drawn = nil
+}
+
+func statusColorOf(s ir.Status) color.Color {
+	switch s {
+	case ir.Succeeded, ir.PartiallySucceeded:
+		return colorDone
+	case ir.Failed, ir.Aborted:
+		return colorFail
+	default:
+		return colorText
+	}
+}
+
+// cleanLine returns a line of output as text safe to print: no escape
+// sequences or control characters, only what follows its last carriage
+// return, and tabs expanded.
+func cleanLine(line string) string {
+	line = strings.TrimRight(line, "\r")
+	if j := strings.LastIndexByte(line, '\r'); j >= 0 {
+		line = line[j+1:]
+	}
+	return printable(expandTabs(stringutil.StripANSI(line)))
+}
+
+// printable drops what would move the cursor or change the terminal's state
+// rather than print: control characters and invalid UTF-8.
+func printable(s string) string {
+	return strings.Map(func(r rune) rune {
+		if r < 0x20 || (r >= 0x7f && r <= 0x9f) {
+			return -1
+		}
+		return r
+	}, strings.ToValidUTF8(s, "�"))
+}
+
+func expandTabs(s string) string {
+	if !strings.Contains(s, "\t") {
+		return s
+	}
+	var b strings.Builder
+	col := 0
+	for _, r := range s {
+		if r == '\t' {
+			spaces := 8 - col%8
+			b.WriteString(strings.Repeat(" ", spaces))
+			col += spaces
+			continue
+		}
+		b.WriteRune(r)
+		col += runewidth.RuneWidth(r)
+	}
+	return b.String()
+}
+
+// fit cuts plain text s to width columns, marking a cut with an ellipsis.
+func fit(s string, width int) string {
+	return runewidth.Truncate(s, max(width, 0), "…")
+}
