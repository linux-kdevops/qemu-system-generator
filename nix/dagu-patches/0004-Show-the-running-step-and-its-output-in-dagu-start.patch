diff --git a/internal/runtime/agent/agent.go b/internal/runtime/agent/agent.go
index 1e40b0fd0..0dd2238d1 100644
--- a/internal/runtime/agent/agent.go
+++ b/internal/runtime/agent/agent.go
@@ -795,6 +795,16 @@ func (a *Agent) Run(ctx context.Context) (runErr error) {
 	if a.logWriterFactory != nil {
 		contextOpts = append(contextOpts, runtime.WithLogWriterFactory(a.logWriterFactory))
 	}
+	if a.progressDisplay == nil {
+		// A sub-DAG run in this process reports to the display of the run
+		// that started it.
+		if parent, ok := runctx.OutputTapFrom(ctx).(subRunReporter); ok {
+			a.progressDisplay = parent.SubRunProgress(a.dagRunID)
+		}
+	}
+	if tap, ok := a.progressDisplay.(runtime.OutputTap); ok {
+		contextOpts = append(contextOpts, runtime.WithOutputTap(tap))
+	}
 	ctx = runtime.NewContext(ctx, a.dag, a.dagRunID, a.logFile, contextOpts...)
 	ctx = runtimeexec.WithSubWorkflowRunner(ctx, subWorkflowRunner)
 	if a.workspaceSeed != nil {
@@ -1101,8 +1111,11 @@ func (a *Agent) Run(ctx context.Context) (runErr error) {
 			<-progressDone
 		}
 		if a.progressDisplay != nil {
-			// Give a small delay to ensure final render
-			time.Sleep(100 * time.Millisecond)
+			// Give a small delay to ensure final render. A sub-DAG run's
+			// reporter draws nothing of its own.
+			if _, sub := a.progressDisplay.(*regionSubRunReporter); !sub {
+				time.Sleep(100 * time.Millisecond)
+			}
 			a.progressDisplay.Stop()
 		}
 	}()
