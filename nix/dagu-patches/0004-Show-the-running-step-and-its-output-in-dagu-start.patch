+	first, second := p.SubRunProgress("child-1"), p.SubRunProgress("child-2")
+	first.UpdateNode(&ir.Node{Step: ir.Step{Name: "start"}, Status: ir.NodeRunning})
+	_, _ = first.(runtimeOutputTap).StepOutput("start").Write([]byte("passed\n"))
+	first.UpdateNode(&ir.Node{Step: ir.Step{Name: "start"}, Status: ir.NodeSucceeded})
+	second.UpdateNode(&ir.Node{Step: ir.Step{Name: "fail"}, Status: ir.NodeRunning})
+	_, _ = second.(runtimeOutputTap).StepOutput("fail").Write([]byte("error\n"))
+	second.UpdateNode(&ir.Node{Step: ir.Step{Name: "fail"}, Status: ir.NodeFailed})
+	first.UpdateNode(&ir.Node{Step: ir.Step{Name: "next"}, Status: ir.NodeRunning})
+
+	assert.Nil(t, p.nodes[subRunKey("child-1", "start")].lines)
+	assert.Equal(t, []string{"error"}, p.nodes[subRunKey("child-2", "fail")].lines)
+}
